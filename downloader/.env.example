# Copy to .env next to docker-compose.yml and adjust.
#
#   cp .env.example .env

# Host port the dashboard is published on.
DRAMADOWN_PORT=3000

# Host directory that receives downloads/<Drama Title>/.
# Downloads are additive — existing files are skipped, never deleted.
DRAMADOWN_DOWNLOADS=./downloads

# Own new files as your media user instead of root.
# Find them with: id -u && id -g
# The directory above must be writable by this uid/gid.
PUID=0
PGID=0

# How long to wait for a Cloudflare challenge, in milliseconds.
# The first run on a fresh profile is the slow one; later runs reuse the cookie.
DRAMADOWN_CHALLENGE_TIMEOUT_MS=90000

# Container timezone. docker-compose.yml defaults this to America/Santo_Domingo;
# uncomment below to override it on a host in another zone.
#   TZ=America/Santo_Domingo
