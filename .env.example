# Copy to .env and fill in. `docker compose up -d` reads this file automatically.

# --- Required ------------------------------------------------------------------------------

# Signs invite and magic-link tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every outstanding invitation and sign-in link.
DRAMATARR_SECRET_KEY=

# Absolute path to your NAS media library on the Docker host. Mounted read-only.
# Expected layout:
#   <library>/Series Name (2024)/Season 01/Series Name - S01E03 - Title.mkv
#   <library>/Series Name/Series Name - 03.mp4
DRAMATARR_LIBRARY_PATH=/mnt/tank/media/series

# Where the database, cached artwork, thumbnails and extracted subtitles live. Put this on a
# dataset you back up — losing it loses every account, passkey and watch position, though not
# a single video. Must be writable by DRAMATARR_UID:DRAMATARR_GID below.
DRAMATARR_DATA_PATH=/mnt/apps/docker_data/dramatarr

# The container runs unprivileged as this uid:gid. Match it to whoever owns DATA_PATH, and
# make sure it can at least read LIBRARY_PATH.
DRAMATARR_UID=1000
DRAMATARR_GID=1000

# --- Networking ----------------------------------------------------------------------------

# Host port the web UI is published on.
DRAMATARR_PORT=8080

# The URL people actually type. Used to build links in outgoing email.
DRAMATARR_PUBLIC_URL=http://localhost:8080

# --- Passkeys ------------------------------------------------------------------------------
#
# WebAuthn binds credentials to a domain. RP_ID must be the registrable domain WITHOUT
# scheme or port; ORIGIN must be the full origin including both, and must match what the
# browser shows. Get these wrong and passkey registration fails with an opaque browser error.
#
# Local testing:            RP_ID=localhost        ORIGIN=http://localhost:8080
# LAN by IP:                passkeys will NOT work — browsers require localhost or a real
#                           domain over https. Use a hostname with TLS instead.
# Reverse proxy with TLS:   RP_ID=dramatarr.casa.example
#                           ORIGIN=https://dramatarr.casa.example
DRAMATARR_WEBAUTHN_RP_ID=localhost
DRAMATARR_WEBAUTHN_RP_NAME=dramatarr
DRAMATARR_WEBAUTHN_ORIGIN=http://localhost:8080

# --- First run -----------------------------------------------------------------------------

# On an empty database this address becomes the first admin, and the enrollment URL for its
# passkey is printed to the api container log. Read it with:
#   docker compose logs api | grep -i enrollment
DRAMATARR_BOOTSTRAP_ADMIN_EMAIL=

# --- Optional ------------------------------------------------------------------------------

DRAMATARR_DEFAULT_LOCALE=es
DRAMATARR_SESSION_TTL_DAYS=30
DRAMATARR_LOG_LEVEL=INFO

# Everything else — TMDB key, SMTP, scan schedule — is configured from the admin UI at
# /admin/settings and stored in the database, so it survives container rebuilds.
