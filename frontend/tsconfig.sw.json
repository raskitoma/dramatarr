{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/sw.ts",
    "src/offline/constants.ts",
    "src/offline/route.ts"
  ]
}
