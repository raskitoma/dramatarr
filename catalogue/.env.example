# Copy to .env and fill in. Generate a key with:  openssl rand -hex 32
DRAMADEX_API_KEY=

# Which host address the container publishes on.
#   127.0.0.1  loopback only (default, safest)
#   0.0.0.0    reachable from your LAN
# There is no TLS: the API key travels in clear, so only open this on a network
# you trust, and never expose it to the internet without a proxy terminating TLS.
DRAMADEX_BIND=127.0.0.1
DRAMADEX_PORT=8080

# Day boundary for the "one scheduled run per source per day" rule.
DRAMADEX_TZ=UTC

# Cap on items ingested by a full_catalog run. 0 = uncapped.
# Stays at 50 until the parsers are proven against real data.
DRAMADEX_MAX_ITEMS=50

# Identify the crawler honestly: an operator who objects should be able to
# reach you rather than having to block you.
DRAMADEX_USER_AGENT=DramadexBot/0.1 (self-hosted metadata indexer)

# How many historical payloads to keep per URL in the raw archive.
DRAMADEX_ARCHIVE_KEEP_VERSIONS=1

# In-process scheduler. Set false to drive every sync by hand.
DRAMADEX_SCHEDULER_ENABLED=true
DRAMADEX_SCHEDULER_INTERVAL_SECONDS=300
# Earliest local hour a scheduled sync may start (blank = any time).
DRAMADEX_SYNC_HOUR=3
