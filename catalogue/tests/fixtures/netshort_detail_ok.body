_ID\",\"url\":\"/id/full-episodes/maaf-aku-mencintaimu-1894647842335059969\"},{\"value\":\"pt\",\"label\":\"Português\",\"iso\":\"pt_PT\",\"url\":\"/pt\"},{\"value\":\"cn\",\"label\":\"简体中文\",\"iso\":\"zh_CN\",\"url\":\"/cn\"},{\"value\":\"it\",\"label\":\"Italiano\",\"iso\":\"it_IT\",\"url\":\"/it\"},{\"value\":\"de\",\"label\":\"Deutsch\",\"iso\":\"de_DE\",\"url\":\"/de\"},{\"value\":\"fr\",\"label\":\"Français\",\"iso\":\"fr_FR\",\"url\":\"/fr\"},{\"value\":\"tr\",\"label\":\"Türkçe\",\"iso\":\"tr_TR\",\"url\":\"/tr\"},{\"value\":\"ms\",\"label\":\"Melayu\",\"iso\":\"ms_MY\",\"url\":\"/ms\"},{\"value\":\"ar\",\"label\":\"عربي\",\"iso\":\"ar_AE\",\"url\":\"/ar\"},{\"value\":\"vi\",\"label\":\"Tiếng Việt\",\"iso\":\"vi_VN\",\"url\":\"/vi\"},{\"value\":\"hi\",\"label\":\"हिंदी\",\"iso\":\"hi_IN\",\"url\":\"/hi\"}],\"serverPathname\":\"/full-episodes/love-lights-my-way-back-home-1808387443220733954\",\"serverLanguageDetail\":\"$3:props:messages:languageDetail:list\"}]\n"])</script><script>self.__next_f.push([1,"6:[\"$L29\",[\"$\",\"$L2a\",null,{\"locale\":\"en\",\"videoName\":\"love-lights-my-way-back-home-1808387443220733954\",\"shortPlayDetail\":{\"shortPlayId\":\"1808387443220733954\",\"shortPlayName\":\"Love Lights My Way Back Home\",\"shortPlayUrl\":\"/episode/love-lights-my-way-back-home-1808387443220733954\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/2143139163_3比411.05.50.jpg~tplv-vod-noop.image\",\"shortPlayLibraryId\":\"1894647833539604482\",\"shortPlayLabels\":{\"Modern Romance\":\"/drama/Modern%20Romance-1983832092736479234\",\"Finding Relatives\":\"/drama/Finding%20Relatives-1983832092107333635\",\"Tragic Love\":\"/drama/Tragic%20Love-1983832091075534850\"},\"shotIntroduce\":\"Branded as a family jinx, Bonnie was cast out as a child, left mute by a fever, and taken in by a poor family who renamed her Sunny. Years later, she enters college, only to be bullied by a wealthy classmate—her twin brother, though neither knows the truth. As their fates entwine, can Bonnie uncover the secrets of her banishment and reclaim her place in the family?\",\"totalLikeNums\":\"3.2K\",\"totalChaseNums\":\"16.7K\"},\"episodeList\":[{\"episodeId\":\"1808387666554839042\",\"episodeNo\":1,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/51b6fe5c59804a6baa061739c8cf244c~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/51b6fe5c59804a6baa061739c8cf244c~tplv-vod-noop.image\",\"episodeTitle\":\"The Jinxed Twin\",\"episodeIntroduce\":\"The Golden family believes Bonnie is a jinx bringing misfortune, leading to her forced exile by her grandfather, despite her parents' desperate pleas.Will Bonnie ever reunite with her family and uncover the truth behind her banishment?\"},{\"episodeId\":\"1808391971891134466\",\"episodeNo\":2,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/84f5af5334704a4496676c47c581a5ee~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/84f5af5334704a4496676c47c581a5ee~tplv-vod-noop.image\",\"episodeTitle\":\"The Silent Beginning\",\"episodeIntroduce\":\"The episode begins with a tragic turn as a young girl, later named Sunny, is found abandoned and suffering from a fever that leaves her mute. Years later, her adoptive father, Shaw, receives unexpected news that Sunny has earned a prestigious scholarship to Eaton Academy, only to be urgently called to the school due to an undisclosed problem involving Sunny.What trouble has Sunny encountered at Eaton Academy, and how will it unveil the hidden truths of her past?\"},{\"episodeId\":\"1808391971895328769\",\"episodeNo\":3,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/e1e64e70fd664a3c83c060934ad24d59~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/e1e64e70fd664a3c83c060934ad24d59~tplv-vod-noop.image\",\"episodeTitle\":\"Bullying Exposed\",\"episodeIntroduce\":\"Sunny faces bullying from her wealthy classmate Chuck Golden, who is unaware that she is his twin sister. When Chuck refuses to apologize for cutting her uniform, the situation escalates as the teacher calls his parents, setting the stage for a dramatic confrontation.Will Chuck's parents recognize Sunny as their long-lost daughter when they arrive?\"},{\"episodeId\":\"1808391971895328770\",\"episodeNo\":4,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/25f27ab1aa9d41ed91bf4b478383fe43~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/25f27ab1aa9d41ed91bf4b478383fe43~tplv-vod-noop.image\",\"episodeTitle\":\"Family Secrets and School Bullying\",\"episodeIntroduce\":\"In this intense episode, tensions escalate when Bonnie (Sunny Shaw) is bullied by her wealthy classmate Chuck, who unknowingly is her twin brother. The situation comes to a head when Chuck insults Bonnie's adoptive family, provoking a violent reaction. The school director is forced to intervene as the conflict reveals deeper family secrets and unresolved issues.Will Bonnie uncover the truth about her connection to Chuck and reclaim her rightful place in the family?\"},{\"episodeId\":\"1808391971895328771\",\"episodeNo\":5,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/6bc2ff998a7147ef975c869c90364b1e~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/6bc2ff998a7147ef975c869c90364b1e~tplv-vod-noop.image\",\"episodeTitle\":\"Twin's Cruelty\",\"episodeIntroduce\":\"Sunny faces severe bullying from her wealthy classmate, who unknowingly is her twin brother, leading to a confrontation where she's threatened with expulsion unless her father kneels in apology.Will Sunny's father kneel to keep her in school, or will this confrontation reveal more about her mysterious past?\"},{\"episodeId\":\"1808391971895328772\",\"episodeNo\":6,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/858d6b09d90d4ae39511a88bc49696f7~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/858d6b09d90d4ae39511a88bc49696f7~tplv-vod-noop.image\",\"episodeTitle\":\"Forced Humiliation\",\"episodeIntroduce\":\"A character is pressured to kneel before a powerful figure, Mr. Chuck, highlighting a moment of intense humiliation and power imbalance, which leads to a dramatic declaration of quitting.Will the protagonist's decision to quit lead to a confrontation with Mr. Chuck?\"},{\"episodeId\":\"1808391971895328773\",\"episodeNo\":7,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/43b6a9970c35422baf80e052de692c6c~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/43b6a9970c35422baf80e052de692c6c~tplv-vod-noop.image\",\"episodeTitle\":\"Birthday Tensions\",\"episodeIntroduce\":\"Chuck plans a lavish birthday party and invites his classmates, including Sunny, whom he bullies. Sunny refuses to attend, hinting at her painful past and the unresolved tension between them.Will Sunny's defiance lead to a confrontation with Chuck at his birthday party?\"},{\"episodeId\":\"1808391971895328774\",\"episodeNo\":8,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/f5588ffd1c52471faa90884fe741001a~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/f5588ffd1c52471faa90884fe741001a~tplv-vod-noop.image\",\"episodeTitle\":\"Birthday Surprise\",\"episodeIntroduce\":\"During a birthday celebration, a delivery man crashes the party and is mistaken for Sunny's father, causing confusion and revealing underlying tensions among the guests.Will Sunny discover the true identity of the mysterious delivery man and the secrets he might hold?\"},{\"episodeId\":\"1808391971895328775\",\"episodeNo\":9,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/5c290b7d434e4ed3ae83f5694b45f9c7~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/5c290b7d434e4ed3ae83f5694b45f9c7~tplv-vod-noop.image\",\"episodeTitle\":\"Strength and Respect\",\"episodeIntroduce\":\"A crippled man impresses a group of people by carrying a heavy object up to their location, showcasing unexpected strength and earning their respect and admiration.Will the crippled man's newfound respect last, or will the group's admiration turn into something more sinister?\"},{\"episodeId\":\"1808391971895328776\",\"episodeNo\":10,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/54783054b89145e79e8747fabc822927~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/54783054b89145e79e8747fabc822927~tplv-vod-noop.image\",\"episodeTitle\":\"The Bullying Incident\",\"episodeIntroduce\":\"Sunny's twin brother and his friends cruelly mock and bully Sunny's adoptive father, unaware of their shared family connection, escalating the tension between the siblings.Will Sunny discover the truth about her twin brother and confront him about his cruel behavior?\"},{\"episodeId\":\"1808391971895328777\",\"episodeNo\":11,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/609f654d1f78483fa952c6fa35531563~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/609f654d1f78483fa952c6fa35531563~tplv-vod-noop.image\",\"episodeTitle\":\"The Birthday Wish\",\"episodeIntroduce\":\"At a party, Mr. Chuck makes a heartfelt wish for Bonnie's return, revealing a deep longing for reconciliation, only for chaos to ensue when someone reacts violently to the mention of Bonnie's name.Who is so opposed to Bonnie's return that they react with such hostility?\"},{\"episodeId\":\"1808391971899523073\",\"episodeNo\":12,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/86f631323faa474c9b5330c892b8ec66~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/86f631323faa474c9b5330c892b8ec66~tplv-vod-noop.image\",\"episodeTitle\":\"A Mother's Fury\",\"episodeIntroduce\":\"A heated confrontation erupts when a mother fiercely defends her daughter Sunny from attackers, leading to a moment of recognition that hints at a deeper connection between Sunny and one of the assailants.Who is the mysterious person that recognizes Sunny, and what is their hidden connection?\"},{\"episodeId\":\"1808391971899523074\",\"episodeNo\":13,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/9c6ad55c27844393943bca565e2d2c50~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/9c6ad55c27844393943bca565e2d2c50~tplv-vod-noop.image\",\"episodeTitle\":\"Echoes of the Past\",\"episodeIntroduce\":\"Bonnie encounters someone who seems to recognize her, calling her by her original name repeatedly, hinting at a possible connection to her forgotten past.Who is the person calling Bonnie's name, and what secrets do they hold about her true identity?\"},{\"episodeId\":\"1808391971899523075\",\"episodeNo\":14,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/e0125b208b194fbabd4561e69134e2fe~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/e0125b208b194fbabd4561e69134e2fe~tplv-vod-noop.image\",\"episodeTitle\":\"The Shocking Rejection\",\"episodeIntroduce\":\"Bonnie faces brutal humiliation by Chuck's mother, who accuses her of being a gold digger and bans her from their family, leading to a shocking revelation about a missing necklace gifted by Chuck.Will Bonnie uncover the truth behind the missing necklace and her connection to the Golden family?\"},{\"episodeId\":\"1808391971899523076\",\"episodeNo\":15,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/967a98c23ef34c9e95805b0664b579c6~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/967a98c23ef34c9e95805b0664b579c6~tplv-vod-noop.image\",\"episodeTitle\":\"Stolen Necklace Accusation\",\"episodeIntroduce\":\"Sunny is falsely accused of stealing Mrs. Golden's unique necklace, a gift from Chuck, and faces intense prejudice and demands from the Golden family, despite her protests of innocence.Will Sunny be able to prove her innocence and uncover the real thief?\"},{\"episodeId\":\"1808400632071249922\",\"episodeNo\":16,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/768cdb07bfcf46a7b3b9bb786f13cfbd~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/768cdb07bfcf46a7b3b9bb786f13cfbd~tplv-vod-noop.image\",\"episodeTitle\":\"The Necklace Conflict\",\"episodeIntroduce\":\"Bonnie is violently searched and accused of stealing a necklace by her wealthy classmate's family, leading to a tense confrontation where her innocence is proven at the last moment, but not without leaving a threat of future retaliation.Will Bonnie be able to uncover the truth behind her banishment before the wealthy family makes good on their threat?\"},{\"episodeId\":\"1808400632075444225\",\"episodeNo\":17,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/0913a2425c964cdc9e067f94a5049be6~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/0913a2425c964cdc9e067f94a5049be6~tplv-vod-noop.image\",\"episodeTitle\":\"The Hidden Truth Revealed\",\"episodeIntroduce\":\"Bonnie, who has been living under the identity of Sunny, faces bullying from her wealthy classmate—unbeknownst to both, her twin brother. Amidst the chaos, a critical moment unfolds when a character, possibly a caretaker, discovers something shocking related to Bonnie's true identity, hinting at the unraveling of long-held family secrets.What shocking discovery about Bonnie's past will come to light next?\"},{\"episodeId\":\"1808400632075444226\",\"episodeNo\":18,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/f8f4e7fa14934ee9848c21a3beccb1a5~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/f8f4e7fa14934ee9848c21a3beccb1a5~tplv-vod-noop.image\",\"episodeTitle\":\"The Search for Bonnie\",\"episodeIntroduce\":\"During a student event, a bangle half is found, leading the family to believe Bonnie is present among the guests. They plan a campus-wide health check to identify her through DNA, while also dealing with a family member's serious health condition.Will the DNA health check reveal Bonnie's true identity, and how will her family react to the discovery?\"},{\"episodeId\":\"1808400632075444227\",\"episodeNo\":19,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/2f964c700eae43f89eb53ec16322067b~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/2f964c700eae43f89eb53ec16322067b~tplv-vod-noop.image\",\"episodeTitle\":\"Tutoring for a Cause\",\"episodeIntroduce\":\"Sunny, struggling to earn money for her sick father, is unexpectedly offered a lucrative tutoring job by her wealthy classmate (unbeknownst to them, her twin brother), despite his mother's disapproval and prejudice against her.Will Sunny's tutoring job lead her closer to uncovering her true identity and the secrets of her past?\"},{\"episodeId\":\"1808400632075444228\",\"episodeNo\":20,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/6b48dacf6dbc422790652cc7894d0fc4~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/6b48dacf6dbc422790652cc7894d0fc4~tplv-vod-noop.image\",\"episodeTitle\":\"The Drowning Secret\",\"episodeIntroduce\":\"Sunny faces bullying from her wealthy classmate, who turns out to be her twin brother, and a near-fatal incident reveals deeper family conflicts and secrets.Will Sunny uncover the truth about her past after this life-threatening encounter?\"}],\"totalCount\":70,\"pageNum\":1,\"pageSize\":20}]]\n"])</script><script>self.__next_f.push([1,"a:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Love Lights My Way Back Home Full Movie - NetShort\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Branded as a family jinx, Bonnie was cast out as a child, left mute by a fever, and taken in by a poor family who renamed her Sunny. Years l...Instantly view all episodes of Love Lights My Way Back Home on NetShort and enjoy the drama anytime, anywhere.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"Short Drama, Drama Movies, Films, Short Video, Drama Story, Netshort\"}],[\"$\",\"link\",\"3\",{\"rel\":\"next\",\"href\":\"https://netshort.com/full-episodes/love-lights-my-way-back-home-1808387443220733954/page/2\"}],[\"$\",\"link\",\"4\",{\"rel\":\"canonical\",\"href\":\"https://netshort.com/full-episodes/love-lights-my-way-back-home-1808387443220733954\"}],[\"$\",\"link\",\"5\",{\"rel\":\"alternate\",\"hrefLang\":\"zh-TW\",\"href\":\"https://netshort.com/zh/full-episodes/%E5%B0%8D%E4%B8%8D%E8%B5%B7%E6%88%91%E6%84%9B%E4%BD%A0-1894647836274290690\"}],[\"$\",\"link\",\"6\",{\"rel\":\"alternate\",\"hrefLang\":\"ko-KR\",\"href\":\"https://netshort.com/ko/full-episodes/%EC%9E%AC%EB%B2%8C%EC%A7%91-%EC%9E%83%EC%96%B4-%EB%B2%84%EB%A6%B0-%EB%A7%89%EB%82%B4%EB%94%B8-1894647837729714178\"}],[\"$\",\"link\",\"7\",{\"rel\":\"alternate\",\"hrefLang\":\"en-US\",\"href\":\"https://netshort.com/full-episodes/love-lights-my-way-back-home-1808387443220733954\"}],[\"$\",\"link\",\"8\",{\"rel\":\"alternate\",\"hrefLang\":\"id-ID\",\"href\":\