":\"ar\",\"label\":\"عربي\",\"iso\":\"ar_AE\",\"url\":\"/ar\"},{\"value\":\"vi\",\"label\":\"Tiếng Việt\",\"iso\":\"vi_VN\",\"url\":\"/vi\"},{\"value\":\"hi\",\"label\":\"हिंदी\",\"iso\":\"hi_IN\",\"url\":\"/hi\"}],\"serverPathname\":\"/es/full-episodes/perd%C3%B3name-te-amo-1894647840766390274\",\"serverLanguageDetail\":\"$3:props:messages:languageDetail:list\"}]\n"])</script><script>self.__next_f.push([1,"29:I[13749,[\"8026\",\"static/chunks/8026-fdd01cef9ed9fcad.js\",\"1356\",\"static/chunks/1356-497180fb2a2b715f.js\",\"5604\",\"static/chunks/5604-cb71f96ffe3b244d.js\",\"5481\",\"static/chunks/5481-68517c0c75307f2a.js\",\"6600\",\"static/chunks/6600-938d05f4f11e6e45.js\",\"763\",\"static/chunks/763-40f1211051022861.js\",\"5751\",\"static/chunks/5751-fef6912a7c98bd8e.js\",\"1696\",\"static/chunks/1696-9e91d782d1d12c68.js\",\"7047\",\"static/chunks/7047-c0f1eadfb9511a66.js\",\"4345\",\"static/chunks/app/not-found-25a6839a5f071917.js\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"17:[\"$\",\"$L29\",null,{\"list\":[{\"shortPlayLibraryId\":\"2089618690027483137\",\"shortPlayId\":\"2089618757027295233\",\"shortPlayName\":\"El rey que limpiaba armaduras\",\"shortPlayNameNoHL\":\"El rey que limpiaba armaduras\",\"shortPlayNameUrl\":\"/es/episode/el-rey-que-limpiaba-armaduras-2089618757027295233\",\"fullEpisodeNameUrl\":\"/es/full-episodes/el-rey-que-limpiaba-armaduras-2089618757027295233\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089618690027483137/1787466839782-8228974722816513-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Por su difunta esposa, Aser, el guerrero más temido del páramo, selló su poder. Durante tres años vivió humillado como un limpiador de armaduras, ganándose el desprecio de su hijastra Josefina. Pero cuando un clan cruel fuerza a los Sandfang a un combate mortal, amenazando con aniquilarlos, el sello que lo contenía se rompe. Vuelve a ser el Rey, pero, ¿será suficiente para salvarlos?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036294344708\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832036294344708\",\"language\":\"es\"},{\"labelId\":\"1983832036285956101\",\"labelName\":\"Regreso del poderoso\",\"labelNameUrl\":\"/es/drama/Regreso%20del%20poderoso-1983832036285956101\",\"language\":\"es\"},{\"labelId\":\"1983832036302733318\",\"labelName\":\"Venganza\",\"labelNameUrl\":\"/es/drama/Venganza-1983832036302733318\",\"language\":\"es\"}],\"totalEpisode\":51},{\"shortPlayLibraryId\":\"2086767221594148866\",\"shortPlayId\":\"2086767221980024834\",\"shortPlayName\":\"Por tratarme mal, perdió todo\",\"shortPlayNameNoHL\":\"Por tratarme mal, perdió todo\",\"shortPlayNameUrl\":\"/es/episode/por-tratarme-mal-perdió-todo-2086767221980024834\",\"fullEpisodeNameUrl\":\"/es/full-episodes/por-tratarme-mal-perdió-todo-2086767221980024834\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2086767221594148866/7ebaebbace874714bd75149c1b317f5b/2089245061225271298.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Durante años, una empresa fue el mejor cliente de Javier Mendoza. Pero cuando su madre llegó a la cocina, todo se convirtió en una pesadilla. Era sucia, grosera y los estafaba sirviendo sobras. Tras una humillación final, canceló el jefe el pedido de 200 comidas diarias y se fue con su nueva competencia, Sofía. ¿Cómo reaccionará Javier al perder su mayor fuente de ingresos?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832035958800389\",\"labelName\":\"Lucha por herencias\",\"labelNameUrl\":\"/es/drama/Lucha%20por%20herencias-1983832035958800389\",\"language\":\"es\"},{\"labelId\":\"1983832036906713094\",\"labelName\":\"Conflictos empresariales\",\"labelNameUrl\":\"/es/drama/Conflictos%20empresariales-1983832036906713094\",\"language\":\"es\"},{\"labelId\":\"1983832036889935877\",\"labelName\":\"Vida urbana\",\"labelNameUrl\":\"/es/drama/Vida%20urbana-1983832036889935877\",\"language\":\"es\"}],\"totalEpisode\":17},{\"shortPlayLibraryId\":\"2083220091523485697\",\"shortPlayId\":\"2083220096472764417\",\"shortPlayName\":\"Mi victoria limpia su nombre\",\"shortPlayNameNoHL\":\"Mi victoria limpia su nombre\",\"shortPlayNameUrl\":\"/es/episode/mi-victoria-limpia-su-nombre-2083220096472764417\",\"fullEpisodeNameUrl\":\"/es/full-episodes/mi-victoria-limpia-su-nombre-2083220096472764417\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2083220091523485697/1786952161054-1989764106714846-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Valeria Mendoza, una joven nadadora, compite por su madre para sobrevivir. Pero los poderosos Valeria Delgado y Sebastián Cruz intentan destruirla con crueles sabotajes. Tras entrenar en la Cascada, llegó a la final del Campeonato Mundial, donde su equipo enfrentaba una derrota inminente. ¿Logrará una remontada imposible, romper el Récord Mundial y limpiar el nombre de su madre?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832092950388742\",\"labelName\":\"Crecimiento femenino\",\"labelNameUrl\":\"/es/drama/Crecimiento%20femenino-1983832092950388742\",\"language\":\"es\"},{\"labelId\":\"1983832092459655172\",\"labelName\":\"Vínculos familiares\",\"labelNameUrl\":\"/es/drama/Vínculos%20familiares-1983832092459655172\",\"language\":\"es\"},{\"labelId\":\"1984208314792402949\",\"labelName\":\"Superación\",\"labelNameUrl\":\"/es/drama/Superación-1984208314792402949\",\"language\":\"es\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2089892890978082817\",\"shortPlayId\":\"2089892893788266497\",\"shortPlayName\":\"Lo curé y desperté a la bestia\",\"shortPlayNameNoHL\":\"Lo curé y desperté a la bestia\",\"shortPlayNameUrl\":\"/es/episode/lo-curé-y-desperté-a-la-bestia-2089892893788266497\",\"fullEpisodeNameUrl\":\"/es/full-episodes/lo-curé-y-desperté-a-la-bestia-2089892893788266497\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089892890978082817/1787367876875-5884304261789269-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Un santo de sangre pura, obligado a sanar la herida maldita de un prisionero, desata sin querer su salvaje linaje de hombre lobo. Bajo la vigilancia del Consejo de Ancianos, dos rivales cambiaformas borran la línea entre depredador y presa, y entre el deseo prohibido y la rebelión. ¿Quién es el cazador y quién la presa?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832091792760837\",\"labelName\":\"Giro inesperado\",\"labelNameUrl\":\"/es/drama/Giro%20inesperado-1983832091792760837\",\"language\":\"es\"},{\"labelId\":\"1983832092153470982\",\"labelName\":\"Hombre lobo\",\"labelNameUrl\":\"/es/drama/Hombre%20lobo-1983832092153470982\",\"language\":\"es\"},{\"labelId\":\"1983832092736479237\",\"labelName\":\"Romance urbano\",\"labelNameUrl\":\"/es/drama/Romance%20urbano-1983832092736479237\",\"language\":\"es\"}],\"totalEpisode\":52},{\"shortPlayLibraryId\":\"2087119315786285057\",\"shortPlayId\":\"2087119368403832834\",\"shortPlayName\":\"El soberano de dos mundos\",\"shortPlayNameNoHL\":\"El soberano de dos mundos\",\"shortPlayNameUrl\":\"/es/episode/el-soberano-de-dos-mundos-2087119368403832834\",\"fullEpisodeNameUrl\":\"/es/full-episodes/el-soberano-de-dos-mundos-2087119368403832834\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2087119315786285057/1787380980930-3619911664708638-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"En la Tierra, Leo es solo un hombre aplastado por las deudas. Pero un portal dimensional lo convirtió en el posible rey de un mundo de bestias. Con recursos de nuestro mundo, se ganó la lealtad de Janna del Clan Conejo y de la guerrera Selena del Clan del Lobo Plateado. Ahora debe volver para vengarse. ¿Podrá dominar dos mundos o su nuevo poder lo llevará a la perdición?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036239818758\",\"labelName\":\"Superación\",\"labelNameUrl\":\"/es/drama/Superación-1983832036239818758\",\"language\":\"es\"},{\"labelId\":\"1983832036302733318\",\"labelName\":\"Venganza\",\"labelNameUrl\":\"/es/drama/Venganza-1983832036302733318\",\"language\":\"es\"},{\"labelId\":\"1983832036336287749\",\"labelName\":\"Viaje en el tiempo\",\"labelNameUrl\":\"/es/drama/Viaje%20en%20el%20tiempo-1983832036336287749\",\"language\":\"es\"}],\"totalEpisode\":33},{\"shortPlayLibraryId\":\"2088787458003369986\",\"shortPlayId\":\"2088787513015861249\",\"shortPlayName\":\"Me humillaron, pero soy el heredero\",\"shortPlayNameNoHL\":\"Me humillaron, pero soy el heredero\",\"shortPlayNameUrl\":\"/es/episode/me-humillaron-pero-soy-el-heredero-2088787513015861249\",\"fullEpisodeNameUrl\":\"/es/full-episodes/me-humillaron-pero-soy-el-heredero-2088787513015861249\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2088787458003369986/1787382595062-8563914390729842-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Para pagar la deuda de su padre adoptivo, el soldado Adrián custodió a la heredera Valeria. Soportó sus juegos de seducción, pero tenía prohibido tocarla. Cuando se enamoraron, lo expulsó cruelmente por su boda arreglada. Destrozado, Adrián descubrió que es el heredero perdido de los Goodwin. ¿Qué hará Valeria al saber que el hombre que despreció es su única esperanza?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832092082167813\",\"labelName\":\"Identidad oculta\",\"labelNameUrl\":\"/es/drama/Identidad%20oculta-1983832092082167813\",\"language\":\"es\"},{\"labelId\":\"1983832092291883013\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832092291883013\",\"language\":\"es\"},{\"labelId\":\"1983832091792760837\",\"labelName\":\"Giro inesperado\",\"labelNameUrl\":\"/es/drama/Giro%20inesperado-1983832091792760837\",\"language\":\"es\"}],\"totalEpisode\":40},{\"shortPlayLibraryId\":\"2088788074322788353\",\"shortPlayId\":\"2088788132443254785\",\"shortPlayName\":\"Sacrificada a la bestia\",\"shortPlayNameNoHL\":\"Sacrificada a la bestia\",\"shortPlayNameUrl\":\"/es/episode/sacrificada-a-la-bestia-2088788132443254785\",\"fullEpisodeNameUrl\":\"/es/full-episodes/sacrificada-a-la-bestia-2088788132443254785\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2088788074322788353/1787301794465-4374567432528105-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Sacrificada a la bestia maldita Silas, Alba se enamoró de su inesperada ternura. Pero cuando un hechicero los atacó, su primer beso no rompió la maldición y Silas casi murió por protegerla. Desesperada, Alba se arriesgó a todo para darle un Beso de Amor Verdadero. ¿Podrá su amor romper la maldición y despertar la verdadera forma del tirano a tiempo?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832091947950086\",\"labelName\":\"Amor por contrato\",\"labelNameUrl\":\"/es/drama/Amor%20por%20contrato-1983832091947950086\",\"language\":\"es\"},{\"labelId\":\"1983832092291883013\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832092291883013\",\"language\":\"es\"},{\"labelId\":\"1983832091192975365\",\"labelName\":\"Redención\",\"labelNameUrl\":\"/es/drama/Redención-1983832091192975365\",\"language\":\"es\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2089620747404898305\",\"shortPlayId\":\"2089620822449385474\",\"shortPlayName\":\"Me dejó y luego descubrió quién era\",\"shortPlayNameNoHL\":\"Me dejó y luego descubrió quién era\",\"shortPlayNameUrl\":\"/es/episode/me-dejó-y-luego-descubrió-quién-era-2089620822449385474\",\"fullEpisodeNameUrl\":\"/es/full-episodes/me-dejó-y-luego-descubrió-quién-era-2089620822449385474\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089620747404898305/1787380687721-8454094930795726-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Salvó al mundo, pero se retiró por amor. Su prometida, creyendo que era un don nadie, lo abandonó con desprecio. Obsesionada con encontrar al verdadero héroe, organizó un torneo de combate. Pero cuando el caos estalla y el peligro es real, el hombre al que humilló debe revelar su identidad. ¿Cómo reaccionará al descubrir que el don nadie que despreció es el héroe que tanto anhela?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036948656134\",\"labelName\":\"Ciencia ficción\",\"labelNameUrl\":\"/es/drama/Ciencia%20ficción-1983832036948656134\",\"language\":\"es\"},{\"labelId\":\"1983832036294344708\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832036294344708\",\"language\":\"es\"},{\"labelId\":\"1999056777395978245\",\"labelName\":\"Identidad oculta\",\"labelNameUrl\":\"/es/drama/Identidad%20oculta-1999056777395978245\",\"language\":\"es\"}],\"totalEpisode\":46},{\"shortPlayLibraryId\":\"2085931670347042817\",\"shortPlayId\":\"2085931670653227009\",\"shortPlayName\":\"No abras esa puerta otra vez\",\"shortPlayNameNoHL\":\"No abras esa puerta otra vez\",\"shortPlayNameUrl\":\"/es/episode/no-abras-esa-puerta-otra-vez-2085931670653227009\",\"fullEpisodeNameUrl\":\"/es/full-episodes/no-abras-esa-puerta-otra-vez-2085931670653227009\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2085931670347042817/1787459520302-6687217238179695-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Clara Navarro fue devorada viva por una entidad anómala que masacró a sus amigas. Ahora, ha renacido momentos antes de la tragedia. La criatura regresa, imitando a su compañera Lucía Santos para que su amiga Martina Rivas le abra la puerta. Clara debe impedir que el horror se repita y consigue pedir ayuda. Pero cuando el rescate llega, ¿qué aterradora verdad descubrirán sobre la Entidad anómala?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832175679455238\",\"labelName\":\"Suspenso\",\"labelNameUrl\":\"/es/drama/Suspenso-1983832175679455238\",\"language\":\"es\"},{\"labelId\":\"1983832175041921030\",\"labelName\":\"Renacimiento\",\"labelNameUrl\":\"/es/drama/Renacimiento-1983832175041921030\",\"language\":\"es\"},{\"labelId\":\"1983832175222276101\",\"labelName\":\"Campus\",\"labelNameUrl\":\"/es/drama/Campus-1983832175222276101\",\"language\":\"es\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2087714582747299842\",\"shortPlayId\":\"2087714585393905665\",\"shortPlayName\":\"El magnate y su devoción enferma\",\"shortPlayNameNoHL\":\"El magnate y su devoción enferma\",\"shortPlayNameUrl\":\"/es/episode/el-magnate-y-su-devoción-enferma-2087714585393905665\",\"fullEpisodeNameUrl\":\"/es/full-episodes/el-magnate-y-su-devoción-enferma-2087714585393905665\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2087714582747299842/1787553455839-.624121790936522-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Embarazada y abandonada por todos, Chloe Dawson huyó de una vida de desesperación. Había perdido la esperanza en el amor, pero su vida cambió cuando apareció Ethan Merce, dispuesto a protegerla a cualquier precio. Ahora, un secreto sobre su origen está a punto de ser revelado, reuniéndola con su verdadera familia. Este secreto podría cambiarlo todo y darle la oportunidad de un nuevo comienzo.\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832092736479237\",\"labelName\":\"Romance urbano\",\"labelNameUrl\":\"/es/drama/Romance%20urbano-1983832092736479237\",\"language\":\"es\"},{\"labelId\":\"1983832092950388742\",\"labelName\":\"Crecimiento femenino\",\"labelNameUrl\":\"/es/drama/Crecimiento%20femenino-1983832092950388742\",\"language\":\"es\"},{\"labelId\":\"1983832091960532997\",\"labelName\":\"Huida con el bebé\",\"labelNameUrl\":\"/es/drama/Huida%20con%20el%20bebé-1983832091960532997\",\"language\":\"es\"}],\"totalEpisode\":76},{\"shortPlayLibraryId\":\"2091708463618838529\",\"shortPlayId\":\"2091708463983742977\",\"shortPlayName\":\"(Doblado) El dios del trueno de los barrios bajos\",\"shortPlayNameNoHL\":\"(Doblado) El dios del trueno de los barrios bajos\",\"shortPlayNameUrl\":\"/es/episode/doblado-el-dios-del-trueno-de-los-barrios-bajos-2091708463983742977\",\"fullEpisodeNameUrl\":\"/es/full-episodes/doblado-el-dios-del-trueno-de-los-barrios-bajos-2091708463983742977\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/920138879_20260825-105523.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Nate Ryder es un fracasado para todos. Pero en secreto posee el poder del Dios del Trueno de rango SSS. Para proteger a su familia, soporta la humillación de su rival, Tyler, y la injusticia de la academia. En el torneo nacional, todos esperan su derrota frente a Tyler. ¿Qué harán cuando el \\\"inútil\\\" desate la furia de un dios?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036285956101\",\"labelName\":\"Regreso del poderoso\",\"labelNameUrl\":\"/es/drama/Regreso%20del%20poderoso-1983832036285956101\",\"language\":\"es\"},{\"labelId\":\"1983832036390813702\",\"labelName\":\"Agradable\",\"labelNameUrl\":\"/es/drama/Agradable-1983832036390813702\",\"language\":\"es\"}],\"totalEpisode\":61},{\"shortPlayLibraryId\":\"2089181003352702978\",\"shortPlayId\":\"2089181003633721345\",\"shortPlayName\":\"(Doblado) Humillaron al futuro rey\",\"shortPlayNameNoHL\":\"(Doblado) Humillaron al futuro rey\",\"shortPlayNameUrl\":\"/es/episode/doblado-humillaron-al-futuro-rey-2089181003633721345\",\"fullEpisodeNameUrl\":\"/es/full-episodes/doblado-humillaron-al-futuro-rey-2089181003633721345\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/919583743_TheUntouchableMechanic（AI配音）西语.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Traicionado y despojado de su fortuna, Samuel, heredero del imperio Lancaster, fue olvidado. Criado en las sombras por la mafia Mercer, se transformó en el 'Padrino de la Noche'. Por amor a su amada Aveline, renunció a todo para ser un simple mecánico, pero ella lo humilló frente a todos. Ahora que ha vuelto, ¿está el mundo preparado para la venganza del rey?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036239818758\",\"labelName\":\"Superación\",\"labelNameUrl\":\"/es/drama/Superación-1983832036239818758\",\"language\":\"es\"},{\"labelId\":\"1983832036294344708\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832036294344708\",\"language\":\"es\"},{\"labelId\":\"1983832036889935877\",\"labelName\":\"Vida urbana\",\"labelNameUrl\":\"/es/drama/Vida%20urbana-1983832036889935877\",\"language\":\"es\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2085203145411051521\",\"shortPlayId\":\"2085203220707196929\",\"shortPlayName\":\"Después del divorcio, de vuelta a la mafia\",\"shortPlayNameNoHL\":\"Después del divorcio, de vuelta a la mafia\",\"shortPlayNameUrl\":\"/es/episode/después-del-divorcio-de-vuelta-a-la-mafia-2085203220707196929\",\"fullEpisodeNameUrl\":\"/es/full-episodes/después-del-divorcio-de-vuelta-a-la-mafia-2085203220707196929\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2085203145411051521/1787457977016-7945421597258859-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Construí el imperio de mi esposo, pero él me traicionó con otra mujer y un cruel intercambio de bebés. Creyó haberme destruido, pero se equivocó. Soy una heredera millonaria y he vuelto por venganza. Destruiré su negocio y su vida, pero, en medio de mi venganza, ¿encontraré también el verdadero amor?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832092291883013\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832092291883013\",\"language\":\"es\"},{\"labelId\":\"1983832092082167813\",\"labelName\":\"Identidad oculta\",\"labelNameUrl\":\"/es/drama/Identidad%20oculta-1983832092082167813\",\"language\":\"es\"},{\"labelId\":\"1983832091901812741\",\"labelName\":\"Karma\",\"labelNameUrl\":\"/es/drama/Karma-1983832091901812741\",\"language\":\"es\"}],\"totalEpisode\":35},{\"shortPlayLibraryId\":\"2083962457930780674\",\"shortPlayId\":\"2083962461915369474\",\"shortPlayName\":\"Me convertí en la pesadilla de mi esposo\",\"shortPlayNameNoHL\":\"Me convertí en la pesadilla de mi esposo\",\"shortPlayNameUrl\":\"/es/episode/me-convertí-en-la-pesadilla-de-mi-esposo-2083962461915369474\",\"fullEpisodeNameUrl\":\"/es/full-episodes/me-convertí-en-la-pesadilla-de-mi-esposo-2083962461915369474\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2083962457930780674/1786950806221-4190712665906381-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Amnésica, la princesa Elena Mendoza mantuvo a su esposo Diego tallando Miniatura tallada en hueso de melocotón. Su hermano, el emperador Andrés Mendoza, creyéndola feliz, premió a Diego. Pero él, por ambición, la traicionó y ordenó asesinarla. Elena sobrevivió, pero al buscar justicia, le destrozaron las manos y fue exiliada. Ahora ha regresado. ¿Podrá hacerle pagar su traición?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832092107333638\",\"labelName\":\"Búsqueda familiar\",\"labelNameUrl\":\"/es/drama/Búsqueda%20familiar-1983832092107333638\",\"language\":\"es\"},{\"labelId\":\"1983832092291883013\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832092291883013\",\"language\":\"es\"},{\"labelId\":\"1983832091029397508\",\"labelName\":\"Agradable\",\"labelNameUrl\":\"/es/drama/Agradable-1983832091029397508\",\"language\":\"es\"}],\"totalEpisode\":51},{\"shortPlayLibraryId\":\"2085213706400112641\",\"shortPlayId\":\"2085213710015602690\",\"shortPlayName\":\"Me ignoraron y el diluvio llegó\",\"shortPlayNameNoHL\":\"Me ignoraron y el diluvio llegó\",\"shortPlayNameUrl\":\"/es/episode/me-ignoraron-y-el-diluvio-llegó-2085213710015602690\",\"fullEpisodeNameUrl\":\"/es/full-episodes/me-ignoraron-y-el-diluvio-llegó-2085213710015602690\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2085213706400112641/1787192196175-9895011012118812-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Javier Morales construyó un embalse para su pueblo con su propio dinero. Su tío, por envidia, usó una aplicación para convencer a todos de que no pagaran. Javier mostró los recibos, pero no le creyeron. Destruyeron el equipo de seguridad. Javier les advirtió: sin los pernos, el agua se desbordaría. Se rieron de él. Cuando la tormenta llegó, el agua no preguntó quién tenía razón.\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036294344708\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832036294344708\",\"language\":\"es\"},{\"labelId\":\"1983832035992354821\",\"labelName\":\"Arrepentimiento\",\"labelNameUrl\":\"/es/drama/Arrepentimiento-1983832035992354821\",\"language\":\"es\"},{\"labelId\":\"1983832036969627653\",\"labelName\":\"Vida rural\",\"labelNameUrl\":\"/es/drama/Vida%20rural-1983832036969627653\",\"language\":\"es\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2089619595871318018\",\"shortPlayId\":\"2089619655933751297\",\"shortPlayName\":\"Subestimaron al dios reencarnado\",\"shortPlayNameNoHL\":\"Subestimaron al dios reencarnado\",\"shortPlayNameUrl\":\"/es/episode/subestimaron-al-dios-reencarnado-2089619655933751297\",\"fullEpisodeNameUrl\":\"/es/full-episodes/subestimaron-al-dios-reencarnado-2089619655933751297\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089619595871318018/1787567740635-3684410968580678-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Para salvar a todos, el Archimago Sagrado Javier reencarna en un niño indefenso. Él y su hermana Sofía sufren el constante maltrato de sus tíos, quienes ambicionan su Mina de Cristales de Maná. Tras despertar, Javier la ayuda en secreto durante la prueba, pero la crueldad de sus tíos pone la vida de Sofía en peligro. ¿Están preparados para enfrentar al Archimago que humillaron?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036860575750\",\"labelName\":\"Fantasía urbana\",\"labelNameUrl\":\"/es/drama/Fantasía%20urbana-1983832036860575750\",\"language\":\"es\"},{\"labelId\":\"1983832036285956101\",\"labelName\":\"Regreso del poderoso\",\"labelNameUrl\":\"/es/drama/Regreso%20del%20poderoso-1983832036285956101\",\"language\":\"es\"},{\"labelId\":\"1983832036294344708\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832036294344708\",\"language\":\"es\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2085287483456819201\",\"shortPlayId\":\"2085287483909804034\",\"shortPlayName\":\"Rescaté a una princesa de otro mundo\",\"shortPlayNameNoHL\":\"Rescaté a una princesa de otro mundo\",\"shortPlayNameUrl\":\"/es/episode/rescaté-a-una-princesa-de-otro-mundo-2085287483909804034\",\"fullEpisodeNameUrl\":\"/es/full-episodes/rescaté-a-una-princesa-de-otro-mundo-2085287483909804034\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2085287483456819201/1787194085158-9059440725703896-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Javier Morales, un cocinero en la miseria, encontró un portal a la Cocina Imperial. Con su cocina moderna, se ganó el favor de la Princesa Ana y salvó a su familia. Pero la princesa estaba condenada por una traición y un veneno mortal. Para salvarla, la trajo a su tiempo. Ahora es un hombre rico, pero, ¿podrá su amor proteger a una princesa de otro siglo?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036931878917\",\"labelName\":\"Historia antigua\",\"labelNameUrl\":\"/es/drama/Historia%20antigua-1983832036931878917\",\"language\":\"es\"},{\"labelId\":\"1983832036336287749\",\"labelName\":\"Viaje en el tiempo\",\"labelNameUrl\":\"/es/drama/Viaje%20en%20el%20tiempo-1983832036336287749\",\"language\":\"es\"},{\"labelId\":\"1983832036319510534\",\"labelName\":\"Sistema\",\"labelNameUrl\":\"/es/drama/Sistema-1983832036319510534\",\"language\":\"es\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2089261941420072961\",\"shortPlayId\":\"2089261979462406146\",\"shortPlayName\":\"Nodriza de mi propio hijo\",\"shortPlayNameNoHL\":\"Nodriza de mi propio hijo\",\"shortPlayNameUrl\":\"/es/episode/nodriza-de-mi-propio-hijo-2089261979462406146\",\"fullEpisodeNameUrl\":\"/es/full-episodes/nodriza-de-mi-propio-hijo-2089261979462406146\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089261941420072961/1787380989772-.914897661956943-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"La viuda Isabella salvó al héroe de guerra lord Adrian y concibió a su heredero, Leo. Forzada por un oficial, tuvo que abandonar al niño. Años después, el pequeño Leo rechaza a toda nodriza, forzando el regreso de Isabella a la corte. Protegida por Adrian de las intrigas, su linaje oculto está a punto de revelarse. ¿Será su salvación o su perdición?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832092107333638\",\"labelName\":\"Búsqueda familiar\",\"labelNameUrl\":\"/es/drama/Búsqueda%20familiar-1983832092107333638\",\"language\":\"es\"},{\"labelId\":\"1983832092291883013\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832092291883013\",\"language\":\"es\"},{\"labelId\":\"1983832091901812741\",\"labelName\":\"Karma\",\"labelNameUrl\":\"/es/drama/Karma-1983832091901812741\",\"language\":\"es\"}],\"totalEpisode\":36},{\"shortPlayLibraryId\":\"2086332774981607426\",\"shortPlayId\":\"2086332777603047426\",\"shortPlayName\":\"Mi esposa me traicionó\",\"shortPlayNameNoHL\":\"Mi esposa me traicionó\",\"shortPlayNameUrl\":\"/es/episode/mi-esposa-me-traicionó-2086332777603047426\",\"fullEpisodeNameUrl\":\"/es/full-episodes/mi-esposa-me-traicionó-2086332777603047426\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2086332774981607426/d5b73db52bee4db88d33e0f7792f7ae2/2089178063262867457.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Diego Mendoza sacrificó su carrera por Valeria Rojas. Tras cinco años, descubrió su infidelidad con su ex, Emilio Vargas, en la Isla del Susurro. Destrozado, pidió el divorcio. Al volver, Valeria lo encontró cambiado y decidido a rehacer su vida. Con ayuda de su compañera Natalia Soto, retomó su carrera con una expedición a la Antártida. ¿Qué hará al ver triunfar al hombre que traicionó?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036239818758\",\"labelName\":\"Superación\",\"labelNameUrl\":\"/es/drama/Superación-1983832036239818758\",\"language\":\"es\"},{\"labelId\":\"1983832036906713094\",\"labelName\":\"Conflictos empresariales\",\"labelNameUrl\":\"/es/drama/Conflictos%20empresariales-1983832036906713094\",\"language\":\"es\"},{\"labelId\":\"1983832036889935877\",\"labelName\":\"Vida urbana\",\"labelNameUrl\":\"/es/drama/Vida%20urbana-1983832036889935877\",\"language\":\"es\"}],\"totalEpisode\":20},{\"shortPlayLibraryId\":\"2089656317099429890\",\"shortPlayId\":\"2089656319636983809\",\"shortPlayName\":\"Mi esposo me mató, otro dios me salvó\",\"shortPlayNameNoHL\":\"Mi esposo me mató, otro dios me salvó\",\"shortPlayNameUrl\":\"/es/episode/mi-esposo-me-mató-otro-dios-me-salvó-2089656319636983809\",\"fullEpisodeNameUrl\":\"/es/full-episodes/mi-esposo-me-mató-otro-dios-me-salvó-2089656319636983809\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2089656317099429890/2322a97f18e44c7a96a59a2e7a47219b/2090990194201038850.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Lorde, hija del dios del Mar, fue traicionada por su esposo Demos y su doncella Cloris, quienes la arrojaron del Olimpo. Al morir, descubrió que Helios, el depuesto dios del Sol, había sacrificado su divinidad para que ella renaciera. Ahora regresó para buscarlo y vengarse, pero el rey Zeus quería obligarla a otro matrimonio. ¿Podrían reclamar su destino o la traición volvería a destruirlos?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832092417712134\",\"labelName\":\"Romance fantástico\",\"labelNameUrl\":\"/es/drama/Romance%20fantástico-1983832092417712134\",\"language\":\"es\"},{\"labelId\":\"1983832092291883013\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832092291883013\",\"language\":\"es\"},{\"labelId\":\"1983832092069584902\",\"labelName\":\"Pareja poderosa\",\"labelNameUrl\":\"/es/drama/Pareja%20poderosa-1983832092069584902\",\"language\":\"es\"}],\"totalEpisode\":41},{\"shortPlayLibraryId\":\"2086768253711699970\",\"shortPlayId\":\"2086768256437997569\",\"shortPlayName\":\"Una caja vacía, una trampa perfecta\",\"shortPlayNameNoHL\":\"Una caja vacía, una trampa perfecta\",\"shortPlayNameUrl\":\"/es/episode/una-caja-vacía-una-trampa-perfecta-2086768256437997569\",\"fullEpisodeNameUrl\":\"/es/full-episodes/una-caja-vacía-una-trampa-perfecta-2086768256437997569\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2086768253711699970/ebcda8a25cfa4c4bb56bfb073947d1b6/2089240129197727745.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Javier Morales, director del Grupo Financiero Sinceridad, fue extorsionado en la estación por una maleta vacía usando una báscula manipulada. Pagó, pero les hizo firmar un recibo por 50 kg. Inmediatamente después, denunció el robo de 50 kg de oro valorados en 30 millones. El recibo que firmaron se convirtió en su propia trampa legal. ¿Confesarían un robo millonario o su red de extorsión?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036361453574\",\"labelName\":\"Fantasía creativa\",\"labelNameUrl\":\"/es/drama/Fantasía%20creativa-1983832036361453574\",\"language\":\"es\"},{\"labelId\":\"1983832036923490310\",\"labelName\":\"Crimen\",\"labelNameUrl\":\"/es/drama/Crimen-1983832036923490310\",\"language\":\"es\"},{\"labelId\":\"1983832036889935877\",\"labelName\":\"Vida urbana\",\"labelNameUrl\":\"/es/drama/Vida%20urbana-1983832036889935877\",\"language\":\"es\"}],\"totalEpisode\":35},{\"shortPlayLibraryId\":\"2087789938028199937\",\"shortPlayId\":\"2087789941975040001\",\"shortPlayName\":\"La serpiente gigante vino a salvarme\",\"shortPlayNameNoHL\":\"La serpiente gigante vino a salvarme\",\"shortPlayNameUrl\":\"/es/episode/la-serpiente-gigante-vino-a-salvarme-2087789941975040001\",\"fullEpisodeNameUrl\":\"/es/full-episodes/la-serpiente-gigante-vino-a-salvarme-2087789941975040001\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2087789938028199937/1786949680661-.511372834164345-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Contra la voluntad de sus padres, Camila Serrano se casó y se mudó a las montañas. Embarazada de nueve meses, rescató a una pitón gigante atrapada. Poco antes de dar a luz, descubrió que su esposo y toda su familia solo fingían quererla para quedarse con su bebé. Intentó escapar, pero la capturaron. Cuando todo parecía perdido, la pitón regresó para salvarla.\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832092950388742\",\"labelName\":\"Crecimiento femenino\",\"labelNameUrl\":\"/es/drama/Crecimiento%20femenino-1983832092950388742\",\"language\":\"es\"},{\"labelId\":\"1983832091792760837\",\"labelName\":\"Giro inesperado\",\"labelNameUrl\":\"/es/drama/Giro%20inesperado-1983832091792760837\",\"language\":\"es\"},{\"labelId\":\"1983832092291883013\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832092291883013\",\"language\":\"es\"}],\"totalEpisode\":57},{\"shortPlayLibraryId\":\"2086765968814264321\",\"shortPlayId\":\"2086765970034806785\",\"shortPlayName\":\"La furia del dios vagabundo\",\"shortPlayNameNoHL\":\"La furia del dios vagabundo\",\"shortPlayNameUrl\":\"/es/episode/la-furia-del-dios-vagabundo-2086765970034806785\",\"fullEpisodeNameUrl\":\"/es/full-episodes/la-furia-del-dios-vagabundo-2086765970034806785\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2086765968814264321/54e3186e04664ba7a0a81fcd658ed164/2089180543635836930.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Javier, un Mendigo, es en secreto el Príncipe Heredero del Linaje del Dragón. Al salvar a la drogada Clara, hija del Dios de la Fortuna, ella le pidió matrimonio. Pero la Familia Montoya lo humilló y obligó a Clara a elegir entre él y la familia. Clara lo eligió. Conmovido, la coronó reina. ¿Cómo reaccionará la arrogante familia ante el desafío de un Mendigo?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036353064965\",\"labelName\":\"Aventura inesperada\",\"labelNameUrl\":\"/es/drama/Aventura%20inesperada-1983832036353064965\",\"language\":\"es\"}],\"totalEpisode\":88},{\"shortPlayLibraryId\":\"2089561343955496962\",\"shortPlayId\":\"2089561420505743362\",\"shortPlayName\":\"El secreto de mi esposa bailarina\",\"shortPlayNameNoHL\":\"El secreto de mi esposa bailarina\",\"shortPlayNameUrl\":\"/es/episode/el-secreto-de-mi-esposa-bailarina-2089561420505743362\",\"fullEpisodeNameUrl\":\"/es/full-episodes/el-secreto-de-mi-esposa-bailarina-2089561420505743362\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089561343955496962/1787477131849-5567272765590263-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Mi esposa, una estrella de la danza. Un video despertó mis sospechas, pero sus lágrimas me cegaron y le di 200,000 dólares para su estudio. Luego la oí reír con su amante, jactándose de lo fácil que era engañarme. Fui su tonto, su cajero automático. Se acabaron las mentiras. Ahora, solo me mueve la venganza. ¿Creía que su traición saldría gratis?\",\"language\":\"es_ES\",\"labelList\":[{\"labelId\":\"1983832036302733318\",\"labelName\":\"Venganza\",\"labelNameUrl\":\"/es/drama/Venganza-1983832036302733318\",\"language\":\"es\"},{\"labelId\":\"1983832035870720005\",\"labelName\":\"Crecimiento masculino\",\"labelNameUrl\":\"/es/drama/Crecimiento%20masculino-1983832035870720005\",\"language\":\"es\"},{\"labelId\":\"1983832036294344708\",\"labelName\":\"Castigo del karma\",\"labelNameUrl\":\"/es/drama/Castigo%20del%20karma-1983832036294344708\",\"language\":\"es\"}],\"totalEpisode\":27}]}]\n"])</script><script>self.__next_f.push([1,"2b:I[64309,[\"8026\",\"static/chunks/8026-fdd01cef9ed9fcad.js\",\"1356\",\"static/chunks/1356-497180fb2a2b715f.js\",\"5604\",\"static/chunks/5604-cb71f96ffe3b244d.js\",\"5481\",\"static/chunks/5481-68517c0c75307f2a.js\",\"763\",\"static/chunks/763-40f1211051022861.js\",\"5751\",\"static/chunks/5751-fef6912a7c98bd8e.js\",\"6164\",\"static/chunks/6164-278075377c7d4735.js\",\"1888\",\"static/chunks/1888-47e39d9c8a1635ff.js\",\"1934\",\"static/chunks/app/%5Blocale%5D/full-episodes/%5Bepisode%5D/page-279a2fa556b8cd28.js\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"6:[\"$L2a\",[\"$\",\"$L2b\",null,{\"locale\":\"es\",\"videoName\":\"perdóname-te-amo-1894647840766390274\",\"shortPlayDetail\":{\"shortPlayId\":\"1894647840766390274\",\"shortPlayName\":\"Perdóname, te amo\",\"shortPlayUrl\":\"/es/episode/perdóname-te-amo-1894647840766390274\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/-1754759171_3比4.jpg~tplv-vod-noop.image\",\"shortPlayLibraryId\":\"1894647833539604482\",\"shortPlayLabels\":{\"Romance urbano\":\"/es/drama/Romance%20urbano-1983832092736479237\",\"Búsqueda familiar\":\"/es/drama/Búsqueda%20familiar-1983832092107333638\",\"Amor doloroso\":\"/es/drama/Amor%20doloroso-1983832091079729153\"},\"shotIntroduce\":\"Una frase de un Maestro taoísta llevó a la hija de los González a ser abandonada. Más de diez años después, Elena Torres, una estudiante sobresaliente, pero sufrió acoso por parte de su compañero Daniel González debido a su mutismo y su pobreza. Un día, en la casa de los González, Elena tuvo un conflicto con Daniel y cayó al agua. Justo en ese momento, el mayordomo llega con noticias: Elena, en realidad, fue Ana González, a quien los González habían estado buscando durante años...\",\"totalLikeNums\":\"3.2K\",\"totalChaseNums\":\"13.4K\"},\"episodeList\":[{\"episodeId\":\"1894647844675481638\",\"episodeNo\":1,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/51b6fe5c59804a6baa061739c8cf244c~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/51b6fe5c59804a6baa061739c8cf244c~tplv-vod-noop.image\",\"episodeTitle\":\"La Maldición y el Destino\",\"episodeIntroduce\":\"Un maestro taoísta revela que la niña Ana González lleva una maldición que ha causado desgracias a la familia. El abuelo, convencido de esto, decide deshacerse de ella, provocando una desgarradora separación y la promesa de un futuro reencuentro mediante un brazalete.¿Podrá Ana reunirse con su familia y romper la maldición que pesa sobre ella?\"},{\"episodeId\":\"1894647844675481639\",\"episodeNo\":2,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/84f5af5334704a4496676c47c581a5ee~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/84f5af5334704a4496676c47c581a5ee~tplv-vod-noop.image\",\"episodeTitle\":\"El Secreto Revelado\",\"episodeIntroduce\":\"Una niña sin hogar es llevada al hospital con daños cerebrales y en las cuerdas vocales, mientras se revela que Elena, una estudiante sobresaliente, es en realidad Ana González, la hija perdida de la familia González.¿Cómo reaccionará la familia González al descubrir la verdad sobre Elena?\"},{\"episodeId\":\"1894647844679675907\",\"episodeNo\":3,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/e1e64e70fd664a3c83c060934ad24d59~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/e1e64e70fd664a3c83c060934ad24d59~tplv-vod-noop.image\",\"episodeTitle\":\"El conflicto en la escuela\",\"episodeIntroduce\":\"Daniel González, hijo del principal accionista de la escuela, acosa a Elena Torres, una estudiante muda y pobre. Cuando la profesora Martínez exige que Daniel se disculpe, él se niega arrogante, revelando su privilegio y desprecio. Mientras tanto, se insinúa que Elena podría ser Ana González, la hija perdida de la familia.¿Descubrirá Elena su verdadera identidad como Ana González?\"},{\"episodeId\":\"1894647844675481637\",\"episodeNo\":4,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/25f27ab1aa9d41ed91bf4b478383fe43~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/25f27ab1aa9d41ed91bf4b478383fe43~tplv-vod-noop.image\",\"episodeTitle\":\"Conflicto en la Escuela\",\"episodeIntroduce\":\"Elena, una estudiante sobresaliente pero víctima de acoso, tiene un conflicto con Daniel González, su acosador. Durante la discusión, Daniel insulta cruelmente a Elena y su familia, provocando una fuerte reacción de los presentes. La madre de Daniel llega al lugar, defendiendo a su hijo sin escuchar la versión de Elena.¿Qué consecuencias tendrá este incidente para Elena y Daniel en la escuela?\"},{\"episodeId\":\"1894647844675481631\",\"episodeNo\":5,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/6bc2ff998a7147ef975c869c90364b1e~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/6bc2ff998a7147ef975c869c90364b1e~tplv-vod-noop.image\",\"episodeTitle\":\"El Conflicto en la Escuela\",\"episodeIntroduce\":\"Elena, una estudiante brillante, enfrenta la injusticia cuando el director Gómez cede a las demandas de Daniel González, quien exige que su padre solicite su baja de la escuela o que ella se arrodille para disculparse por un conflicto previo.¿Podrá Elena superar esta humillación o su verdadera identidad finalmente saldrá a la luz?\"},{\"episodeId\":\"1894647844679675906\",\"episodeNo\":6,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/858d6b09d90d4ae39511a88bc49696f7~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/858d6b09d90d4ae39511a88bc49696f7~tplv-vod-noop.image\",\"episodeTitle\":\"Humillación y Sumisión\",\"episodeIntroduce\":\"En una tensa confrontación, un padre se ve obligado a arrodillarse ante la familia González para evitar más problemas, mientras su hijo Daniel demuestra su poder y crueldad.¿Qué consecuencias tendrá esta humillación para la relación entre las familias?\"},{\"episodeId\":\"1894647844679675909\",\"episodeNo\":7,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/36d0e202b1fc45a9aead76e1c9aeec25~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/36d0e202b1fc45a9aead76e1c9aeec25~tplv-vod-noop.image\",\"episodeTitle\":\"El cumpleaños y la verdad oculta\",\"episodeIntroduce\":\"Daniel González, quien ha acosado a Elena, se arrodilla y pide disculpas públicamente. Mientras la familia González planea una gran fiesta de cumpleaños para Daniel, se menciona la ausencia de Ana, la hija perdida. Elena recibe una invitación de Daniel bajo coacción, revelando tensiones no resueltas y el posible descubrimiento de su verdadera identidad como Ana González.¿Descubrirá Elena su verdadera identidad durante la fiesta de cumpleaños de Daniel?\"},{\"episodeId\":\"1894647844679675911\",\"episodeNo\":8,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/f5588ffd1c52471faa90884fe741001a~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/f5588ffd1c52471faa90884fe741001a~tplv-vod-noop.image\",\"episodeTitle\":\"El Cumpleaños Revelador\",\"episodeIntroduce\":\"Durante la fiesta de cumpleaños de Daniel González, el repartidor de verduras llega a la mansión y es humillado por los invitados. Se revela que es el padre de Elena, quien sufre acoso por parte de Daniel. La situación escalada cuando Daniel prepara un 'espectáculo' especialmente para Elena, aumentando el conflicto entre ellos.¿Qué hará Elena cuando descubra el verdadero propósito del 'espectáculo' de Daniel?\"},{\"episodeId\":\"1894647844679675908\",\"episodeNo\":9,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/5c290b7d434e4ed3ae83f5694b45f9c7~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/5c290b7d434e4ed3ae83f5694b45f9c7~tplv-vod-noop.image\",\"episodeTitle\":\"La Fuerza Ocultada\",\"episodeIntroduce\":\"Durante un día común, el mayordomo demuestra su increíble fuerza llevando verduras sobre sus hombros con un palo, impresionando a todos alrededor. Más tarde, su habilidad para atrapar frisbees con sus ágiles piernas sorprende aún más, revelando un lado desconocido de su persona.¿Qué más secretos oculta el mayordomo que podrían cambiar el curso de la historia?\"},{\"episodeId\":\"1894647844679675910\",\"episodeNo\":10,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/54783054b89145e79e8747fabc822927~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/54783054b89145e79e8747fabc822927~tplv-vod-noop.image\",\"episodeTitle\":\"El Juego Cruel\",\"episodeIntroduce\":\"Elena, una estudiante callada y pobre, es acosada por sus compañeros de clase, especialmente por Daniel González, quien la humilla junto a su padre en un juego cruel que evidencia la discriminación que sufre.¿Qué pasará cuando los González descubran que Elena es en realidad Ana, la hija que abandonaron años atrás?\"},{\"episodeId\":\"1894647844679675912\",\"episodeNo\":11,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/609f654d1f78483fa952c6fa35531563~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/609f654d1f78483fa952c6fa35531563~tplv-vod-noop.image\",\"episodeTitle\":\"El Deseo y la Revelación\",\"episodeIntroduce\":\"Durante una fiesta, Daniel González expresa su deseo de que su hermana perdida regrese, lo que lleva a un momento de tensión cuando alguien intenta detener a Elena, revelando un posible vínculo entre ella y la familia González.¿Será Elena realmente la hermana perdida de Daniel?\"},{\"episodeId\":\"1894647844679675913\",\"episodeNo\":12,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/86f631323faa474c9b5330c892b8ec66~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/86f631323faa474c9b5330c892b8ec66~tplv-vod-noop.image\",\"episodeTitle\":\"Revelación y Conflicto\",\"episodeIntroduce\":\"Elena, una estudiante silenciosa y pobre, es acosada por Daniel González, pero durante un violento enfrentamiento en la casa de los González, donde Elena cae al agua, el mayordomo revela una impactante verdad: Elena es en realidad Ana González, la hija perdida de la familia.¿Cómo reaccionará la familia González al descubrir que Elena es su hija desaparecida?\"},{\"episodeId\":\"1894647844679675915\",\"episodeNo\":13,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/9c6ad55c27844393943bca565e2d2c50~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/9c6ad55c27844393943bca565e2d2c50~tplv-vod-noop.image\",\"episodeTitle\":\"El Descubrimiento de Ana\",\"episodeIntroduce\":\"Elena descubre su verdadera identidad como Ana González, la hija perdida de la familia González, durante un tenso encuentro con Daniel.¿Cómo reaccionará Elena al saber que su vida ha sido una mentira?\"},{\"episodeId\":\"1894647844679675914\",\"episodeNo\":14,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/e0125b208b194fbabd4561e69134e2fe~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/e0125b208b194fbabd4561e69134e2fe~tplv-vod-noop.image\",\"episodeTitle\":\"El Descubrimiento de Ana\",\"episodeIntroduce\":\"Elena, una estudiante silenciosa y pobre, es acosada por Daniel González. Durante una visita a la casa de los González, Elena tiene un conflicto con Daniel y cae al agua. En ese momento, el mayordomo revela que Elena es en realidad Ana González, la hija que los González habían estado buscando durante años.¿Cómo reaccionarán los González al descubrir que Elena es su hija perdida?\"},{\"episodeId\":\"1894647844679675918\",\"episodeNo\":15,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/967a98c23ef34c9e95805b0664b579c6~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/967a98c23ef34c9e95805b0664b579c6~tplv-vod-noop.image\",\"episodeTitle\":\"El Robo de la Cadena\",\"episodeIntroduce\":\"Elena es acusada injustamente de robar una valiosa cadena que Daniel le regaló a su madre, lo que lleva a un tenso conflicto en la casa de los González donde todos la señalan como culpable sin pruebas.¿Logrará Elena demostrar su inocencia o las acusaciones seguirán aumentando?\"},{\"episodeId\":\"1894647844675481632\",\"episodeNo\":16,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/768cdb07bfcf46a7b3b9bb786f13cfbd~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/768cdb07bfcf46a7b3b9bb786f13cfbd~tplv-vod-noop.image\",\"episodeTitle\":\"La Cadena de la Verdad\",\"episodeIntroduce\":\"Elena es acusada injustamente por la familia González, pero la aparición de una cadena perdida revela una conexión inesperada con su pasado y desencadena un conflicto familiar intenso.¿Qué más secretos ocultará la cadena sobre el verdadero origen de Elena?\"},{\"episodeId\":\"1894647844679675916\",\"episodeNo\":17,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/0913a2425c964cdc9e067f94a5049be6~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/0913a2425c964cdc9e067f94a5049be6~tplv-vod-noop.image\",\"episodeTitle\":\"El Descubrimiento de Ana\",\"episodeIntroduce\":\"Elena, una estudiante callada y pobre, es acosada por Daniel González. Durante un conflicto en la casa de los González, Elena cae al agua y el mayordomo revela que ella es en realidad Ana González, la hija perdida de la familia.¿Cómo reaccionará la familia González al descubrir que Elena es su hija perdida?\"},{\"episodeId\":\"1894647844679675917\",\"episodeNo\":18,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/683d59fa05924955b860bda75bc7d2ad~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/683d59fa05924955b860bda75bc7d2ad~tplv-vod-noop.image\",\"episodeTitle\":\"El Regreso de Ana\",\"episodeIntroduce\":\"Los González descubren un brazalete de jade que pertenecía a Ana, su hija perdida, y deciden organizar un chequeo médico en la escuela para encontrarla. Mientras tanto, Elena enfrenta la difícil situación de su padre enfermo.¿Lograrán los González encontrar a Ana antes de que sea demasiado tarde para Elena y su padre?\"},{\"episodeId\":\"1894647844679675919\",\"episodeNo\":19,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/2f964c700eae43f89eb53ec16322067b~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/2f964c700eae43f89eb53ec16322067b~tplv-vod-noop.image\",\"episodeTitle\":\"Dinero y Mentiras\",\"episodeIntroduce\":\"Elena, una estudiante sobresaliente pero pobre, es acosada por Daniel González, quien se aprovecha de su situación económica para ofrecerle dinero a cambio de ayuda con sus tareas. Mientras tanto, se revela que el padre de Elena está enfermo en el hospital y necesita dinero para su tratamiento. Daniel utiliza esta situación para manipular a Elena, aunque su madre desconfía de ella debido a su pasado.¿Descubrirá Elena las verdaderas intenciones de Daniel y cómo afectará esto su relación con la familia González?\"},{\"episodeId\":\"1894647844679675920\",\"episodeNo\":20,\"episodeCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/6b48dacf6dbc422790652cc7894d0fc4~tplv-vod-noop.image\",\"episodeWebCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/6b48dacf6dbc422790652cc7894d0fc4~tplv-vod-noop.image\",\"episodeTitle\":\"Conflicto en la Casa González\",\"episodeIntroduce\":\"Elena, una tutora muda y pobre, enfrenta acoso de Daniel González mientras intenta ayudarle con sus tareas. El conflicto escala hasta que Elena es empujada al agua, revelando una conexión inesperada con la familia González cuando el mayordomo anuncia que ella es en realidad Ana González, la hija perdida de la familia.¿Cómo reaccionará la familia González al descubrir que Elena es su hija perdida?\"}],\"totalCount\":70,\"pageNum\":1,\"pageSize\":20}]]\n"])</script><script>self.__next_f.push([1,"a:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Perdóname, te amoTodos los episodios - NetShort\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Una frase de un Maestro taoísta llevó a la hija de los González a ser abandonada. Más de diez años después, Elena Torres, una estudiante sob...Mira inmediatamente toda la información de los episodios de Perdóname, te amo en NetShort y disfruta del drama en cu