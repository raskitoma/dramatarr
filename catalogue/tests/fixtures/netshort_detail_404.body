"messages\":{\"404\":{\"error01\":\"The page can't be found!\",\"error02\":\"In 3s, redirecting to Home\"},\"pageTitle\":\"Netshort - Short Drama, Drama Movies, Films, Short Video, Full Episodes Watch Online! \",\"pageDescription\":\"NetShort – Watch the hottest short dramas and trending content! Explore top-rated dramas, connect with creators, and share your favorites. Download now for endless entertainment! \",\"pageKeywords\":\"Short Drama, Drama Movies, Films, Short Video, Drama Story, Netshort\",\"header\":{\"h01\":\"Home\",\"h02\":\"Genres\",\"h03\":\"Download\",\"h04\":\"Blog\",\"h05\":\"Search\",\"h06\":\"Hot Searches\"},\"footer\":{\"f01\":\"About\",\"f02\":\"Contact Us\",\"f03\":\"Community\",\"f04\":\"Drama Series\",\"f05\":\"Terms of Service\",\"f06\":\"Privacy Policy\",\"ja_f07\":\"\",\"ja_f08\":\"\",\"cookieSettings\":\"Cookie Settings\",\"cookiePolicy\":\"Cookie Policy\",\"doNotSell\":\"Do Not Sell or Share My Personal Information\"},\"dramas\":{\"dramas01\":\"All Drama Series\",\"dramas02\":\"Episodes\",\"dramas03\":\"Recommended for you\",\"dramas04\":\"All plots\",\"dramas05\":\"all-plots\",\"default\":{\"title\":\"Free Short Dramas and Films: Mobile-Friendly for Your Vertical Screens - Netshort\",\"and\":\" and \",\"description\":\"more Dramas from Netshort on netshort.com\",\"description2\":\"\",\"keywords1\":\"\",\"keywords2\":\"\"},\"series\":{\"title\":\" Online Free to Watch - Netshort\",\"and\":\" and \",\"description\":\"more Dramas from Netshort on netshort.com\",\"keywords\":\", Netshort\",\"description2\":\"\"},\"episodes\":{\"title\":\" - Netshort\",\"description\":\" episodes, source from Netshort on netshort.com\",\"description2\":\"\"},\"toDubbed\":{\"dubeed\":\"Watch Dubbed\",\"origin\":\"Watch Original\",\"guiding\":\"Not the version you're looking for?\"},\"dramas20\":\"Show More Reviews\",\"dramas20WithCount\":\"Show More Reviews ({count})\",\"dramas21\":\"You've reached the end.\",\"new_recommend_title\":\"For You\",\"allplots\":{\"title\":\"Browse Short Drama Genres \u0026 Shows\"},\"tag\":{\"title\":\"{tagName} Short Dramas \u0026 Reels to Watch Online\"}},\"download\":{\"download01\":\"NetShort - Check out all the hottest short dramas here!\",\"download02\":\"Looking for something to watch during your daily commute,lunchbreak, or just to unwind after a long day? Look no further than our NetShort TV!\",\"download03\":\"From indie films to award-winning TV series, we've got something for everyone. And with new content added regularly. you'll always have something fresh to watch.\",\"download04\":\"Scan the QR code to download, or simply open the link in your phone's browser.\",\"download05\":\"Feel free to click to copy the link!\",\"download06\":\"Download NetShort App\",\"download07\":\"You need to download the app to watch this episode\",\"download08\":\"Download App\",\"title\":\"Download NetShort - The Best App for Short Videos\",\"description\":\"Download NetShort, the ultimate app for creating, watching, and sharing short videos. Explore trending content, connect with creators, and express yourself with ease. Get started now!\",\"keywords\":\"download, NetShort, short video app, NetShort download, video sharing, trending videos\",\"meta\":{\"title\":\"Download NetShort App – Watch Short Dramas Free | NetShort\",\"description\":\"Download the NetShort app for iOS and Android. Watch short dramas, micro dramas, and reels shorts in HD — offline downloads, daily updates, and Exclusive originals.\"},\"nav\":{\"ariaPrimary\":\"Primary\",\"home\":\"Home\",\"genres\":\"Genres\",\"hotSeries\":\"Hot Series\",\"blog\":\"Blog\",\"getTheApp\":\"Get the App\"},\"hero\":{\"eyebrow\":\"Official NetShort App\",\"h1\":\"Download NetShort\",\"lead\":\"Exclusive short drama video — all in HD. Bring trending reels and enjoy drama time on iOS and Android.\",\"ctaDownload\":\"Download for iOS \u0026 Android\",\"ctaWatch\":\"Watch now\",\"noteBefore\":\"Prefer the browser? Watch on\",\"noteOr\":\"or\",\"trustReviews\":\"4.7★ · 1M+ reviews\",\"trustDownloads\":\"100M+ downloads\",\"trustGrossing\":\"#4 top grossing · Entertainment\",\"floatDownloads\":\"100M+ Downloads\",\"floatRating\":\"4.7 · Rating\",\"floatReviews\":\"1M+ Genuine Reviews\",\"badgeExclusive\":\"NetShort Exclusive\",\"phoneTagBaby\":\"Vertical Reels \u0026 Shorts\",\"phoneTagWargod\":\"1080P HD · Short Drama\",\"visualAria\":\"NetShort app drama previews\",\"ratingAria\":\"App ratings\"},\"getApp\":{\"h2\":\"Get the app\",\"lead\":\"Scan the QR code on your phone, or open the store link below.\",\"panelAria\":\"App download\",\"qrAria\":\"QR code to download NetShort\",\"available\":\"Available on the App Store and Google Play — one link for iOS \u0026 Android.\",\"appStore\":\"App Store\",\"googlePlay\":\"Google Play\",\"copyLink\":\"Copy download link\",\"linkCopied\":\"Link copied\",\"copyFailed\":\"Copy failed\"},\"why\":{\"h2\":\"Why the NetShort app\",\"lead\":\"Built for vertical short dramas — faster playback, offline saves, Exclusive drops first, and multiple ways to earn coins to unlock paid episodes.\",\"items\":{\"0\":{\"h3\":\"Short dramas made for mobile\",\"html\":\"Binge \u003clink\u003eshort dramas\u003c/link\u003e and micro dramas in a vertical player designed for commute-length episodes.\"},\"1\":{\"h3\":\"Download \u0026 watch offline\",\"html\":\"Save episodes in the app when available — handy for flights, subway rides, and spotty Wi‑Fi.\"},\"2\":{\"h3\":\"NetShort Exclusive originals\",\"html\":\"Catch Exclusive titles across sweet romance, revenge, aristocratic drama, and underdog comebacks — plus trending \u003clink\u003egood web series\u003c/link\u003e as they drop.\"},\"3\":{\"h3\":\"1080p HD streaming\",\"html\":\"Stream crisp HD on supported titles (VIP where required) — clear picture on phone or tablet.\"},\"4\":{\"h3\":\"17 languages\",\"html\":\"Switch languages in-app for localized short dramas and short videos across major markets.\"},\"5\":{\"h3\":\"Daily new episodes\",\"html\":\"Fresh short series, mini dramas, and trending reels added regularly — watch new videos every day.\"}}},\"reviews\":{\"h2\":\"What viewers say\",\"lead\":\"Real feedback from Google Play and the App Store — people bingeing short dramas on NetShort.\",\"starsAria\":\"4.7 out of 5\",\"ratingMeta\":\"Google Play average · 1M+ ratings · Rated 12+\",\"statsAria\":\"App store highlights\",\"statDownloads\":\"Downloads\",\"statReviews\":\"Reviews\",\"statGrossing\":\"Top grossing · Entertainment\",\"statStreaming\":\"Exclusive short dramas · HD\",\"showMore\":\"Show more reviews (6)\",\"showFewer\":\"Show fewer reviews\",\"source\":\"Curated \u003cstrong\u003e12\u003c/strong\u003e reviews from the \u003cstrong\u003eApp Store\u003c/strong\u003e and \u003cstrong\u003eGoogle Play\u003c/strong\u003e (punctuation lightly cleaned). Highlights: 4.7★ · 100M+ downloads · #4 top grossing in Entertainment · Exclusive short dramas in HD.\"},\"faq\":{\"h2\":\"NetShort App FAQ\",\"lead\":\"Straight answers about downloading the app, free episodes, coins, ads, and offline watching.\",\"moreBefore\":\"Still stuck?\",\"moreFaq\":\"See the full NetShort FAQ\",\"moreOr\":\"or\",\"moreDownload\":\"download the app\",\"moreAfter\":\"and chat in-app.\",\"items\":{\"0\":{\"q\":\"What is the NetShort app?\",\"aText\":\"NetShort is a mobile app for short dramas and micro dramas — Exclusive originals plus licensed series, all in a vertical player. Think binge-friendly episodes for your commute, lunch break, or before bed. It's free to install on iOS and Android, with download links on this page.\",\"aHtml\":\"NetShort is a mobile app for \u003callPlots\u003eshort dramas\u003c/allPlots\u003e and micro dramas — Exclusive originals plus licensed series, all in a vertical player. Think binge-friendly episodes for your commute, lunch break, or before bed. It's free to install on iOS and Android, with \u003cstores\u003edownload links\u003c/stores\u003e on this page.\"},\"1\":{\"q\":\"Why download the app instead of watching on the website?\",\"aText\":\"You can watch series online in a browser anytime. The app is better when you want offline downloads, smoother vertical playback, push updates for new episodes, daily check-ins, and an easier way to manage your library on the go. Many viewers say it's more \\\"addictive\\\" for short breaks — in a good way.\",\"aHtml\":\"You can \u003clink\u003ewatch series online\u003c/link\u003e in a browser anytime. The app is better when you want offline downloads, smoother vertical playback, push updates for new episodes, daily check-ins, and an easier way to manage your library on the go. Many viewers say it's more \\\"addictive\\\" for short breaks — in a good way.\"},\"2\":{\"q\":\"Is NetShort free? How do ads and coins work?\",\"aText\":\"The app is free to download, and a lot of early episodes are free to start. To unlock more, you can watch ads, check in for coins/credits, or use VIP / in-app unlocks — so you can keep watching without always paying upfront. Availability depends on the title and your region; some episodes unlock faster with coins or membership.\",\"aHtml\":\"The app is free to download, and a lot of early episodes are free to start. To unlock more, you can watch ads, check in for coins/credits, or use VIP / in-app unlocks — so you can keep watching without always paying upfront. Availability depends on the title and your region; some episodes unlock faster with coins or membership.\"},\"3\":{\"q\":\"How do I unlock more episodes every day?\",\"aText\":\"Open the app and look for daily check-in, watch-ad rewards, and other coin tasks. Many users earn enough credits for a few episodes a day that way. If a title is locked, finish the reward flow or use coins — then hit play on the next episode.\",\"aHtml\":\"Open the app and look for daily check-in, watch-ad rewards, and other coin tasks. Many users earn enough credits for a few episodes a day that way. If a title is locked, finish the reward flow or use coins — then hit play on the next episode.\"},\"4\":{\"q\":\"Can I download episodes to watch offline?\",\"aText\":\"Yes — offline download is typically available in the NetShort app (not always on the website). Open a series, look for the download icon, and save episodes when your account and that title support it. Handy for flights and spotty Wi‑Fi.\",\"aHtml\":\"Yes — offline download is typically available in the \u003clink\u003eNetShort app\u003c/link\u003e (not always on the website). Open a series, look for the download icon, and save episodes when your account and that title support it. Handy for flights and spotty Wi‑Fi.\"},\"5\":{\"q\":\"Does the app support HD / 1080p?\",\"aText\":\"Yes. NetShort streams Exclusive short drama video in HD on supported titles — including crisp 1080p where available (VIP may be required for the highest quality). After you install, browse trending Hot Series and Exclusive originals.\",\"aHtml\":\"Yes. NetShort streams Exclusive short drama video in HD on supported titles — including crisp 1080p where available (VIP may be required for the highest quality). After you install, browse trending \u003clink\u003eHot Series\u003c/link\u003e and Exclusive originals.\"},\"6\":{\"q\":\"What kinds of short dramas can I watch?\",\"aText\":\"You'll find sweet romance, revenge, wealthy-family intrigue, underdog rise, fantasy, and more — plus NetShort Exclusive originals and daily new episodes. Start from Genres or Hot Series on the web, then continue in the app.\",\"aHtml\":\"You'll find sweet romance, revenge, wealthy-family intrigue, underdog rise, fantasy, and more — plus NetShort Exclusive originals and daily new episodes. Start from \u003callPlots\u003eGenres\u003c/allPlots\u003e or \u003chotseries\u003eHot Series\u003c/hotseries\u003e on the web, then continue in the app.\"},\"7\":{\"q\":\"How do I get help or send feedback?\",\"aText\":\"Fastest path: open the app → Profile → Feedback / customer service. Or email support@netshort.com with your NetShort ID, device, app version, and a short description of the issue. More answers live on our full FAQ.\",\"aHtml\":\"Fastest path: open the app → Profile → Feedback / customer service. Or email \u003csupport\u003esupport@netshort.com\u003c/support\u003e with your NetShort ID, device, app version, and a short description of the issue. More answers live on our \u003cfaq\u003efull FAQ\u003c/faq\u003e.\"}}},\"cta\":{\"h2\":\"Ready to binge?\",\"lead\":\"Install NetShort and start your next short drama in minutes.\",\"download\":\"Download the app\",\"seeAllPlots\":\"See All Plots\"}},\"blog\":{\"blog01\":\"Popular Blog\",\"blog02\":\"Refresh\",\"blog03\":\"Previous\",\"blog04\":\"Next\",\"blog05\":\"You May Like\",\"blog06\":{\"the\":\"Page \",\"page\":\"\"},\"default\":{\"title\":\"Company News, Drama Introduction, Drama Industry Knowledge - Netshort\",\"description\":\"The news channel mainly introduces the company's relevant news, drama introduction and industry knowledge. Welcome to learn about Netshort.\",\"keywords\":\"Company News, Drama Introduction, Drama Industry Knowledge, Netshort\"},\"series\":{\"title\":\" - Netshort\",\"the\":\"The\",\"description\":\" channel mainly introduces the company's \",\"learnMore\":\"Welcome to learn about Netshort.\",\"keywords\":\", Netshort\"},\"details\":{\"title\":\" - Netshort\"},\"recommend_title\":\"More Like This\"},\"common\":{\"common01\":\"Successful Replication\",\"common02\":\"Scan the QR code or click the app market icon to download the APP\",\"common03\":\"Play Now\",\"common04\":\"Open the NetShort APP to unlock more popular dramas \u0026 TV!\",\"common05\":\"Loading\",\"common06\":\"No More\",\"common07\":\"No result we found\",\"common08\":\"Continue Watching\",\"common09\":\"Favorites\",\"common10\":\"completed\",\"common11\":\"Epic Dramas\"},\"yx\":{\"yx01\":\"All Episodes\",\"yx02\":{\"the\":\"EP \",\"episode\":\"\",\"title\":\"{name} Episode {episode} \"},\"yx03\":\"Completed\",\"yx04\":\"Ongoing\",\"yx05\":\"Hot Series\",\"yx06\":\"Storyline\",\"yx07\":\"More details\",\"yx08\":\"Director\",\"yx09\":\"Stars\",\"yx10\":\"Genres\",\"yx11\":\"Country/Region of origin\",\"yx12\":\"Language\",\"yx13\":\"Release date\",\"yx14\":\"Runtime\",\"yx15\":\"min\",\"yx16\":\"Reviews\",\"yx17\":\"Unfold\",\"yx18\":\"Get NetShort and unlock amazing short dramas now!\",\"yx19\":\"NetShort delivers the hottest vertical dramas from around the globe and of all genres, including thrilling Mystery, heart-melting Romance and pulse-pounding Action, all this at your fingertips. Don't miss out! Download NetShort now and start your exclusive journey into the world of short dramas!\",\"yx20\":\"Download\",\"watchOnline\":\" Watch Online - NetShort\",\"title\":\"Hottest English Short Drama Series - NetShort\",\"description\":\"Discover NetShort’s most popular English shor dramas. Romance, revenge, growth and secrets—binge-worthy stories await.\",\"pageTitle\":\" New Release Early Access\",\"pageDescription\":{\"01\":\"Check out real reviews from NetShort viewers for \",\"02\":\", and discover more popular \",\"03\":\" series on NetShort!\"},\"dubbed\":\"(Dubbed)\",\"seo\":{\"title\":\"Hottest Short Drama Series Online\"}},\"fj\":{\"fj01\":\"Full episodes\",\"fj02\":\"Play Now\",\"fj03\":{\"total\":\"\",\"episode\":\" Episodes\"},\"fj04\":{\"all\":\"\",\"episode\":\" Episodes\"},\"aggregation\":{\"title\":\"Discover Full Episodes of NetShort Dramas\",\"description\":\"Want to binge-watch your favorite dramas? Here you’ll find all episodes and get an early preview—never miss a moment of the action!\"},\"details\":{\"title\":\" Full Movie - NetShort\",\"view\":\"...Instantly view all episodes of \",\"description\":\" on NetShort and enjoy the drama anytime, anywhere.\"}},\"error\":{\"error01\":\"The page can't be found!\",\"error03\":\"Refresh\",\"error04\":\"The drama you're looking for is unavailable. You can explore others in various categories.\",\"error02\":\"In {second}s, redirecting to Home\"},\"login\":{\"profile01\":\"Log in\",\"profile02\":\"Sign in. Your journey starts here!\",\"profile03\":\"Sign in with Facebook\",\"profile04\":\"Sign in with Google\",\"profile05\":\"Sign in with Apple\",\"profile06\":\"By loggoing, you agree to the\",\"profile07\":\"User Agreement\",\"profile08\":\"Privacy Policy\",\"profile09\":\"Recent login\",\"profile10\":\"Coins\",\"profile11\":\"Bonus\",\"profile12\":\"Log Out\",\"profile13\":\"Login successful\",\"profile14\":\"login failed\",\"profile15\":\"Session expired. Please log in again.\",\"profile16\":\"Log in\",\"profile17\":\"Log in later\",\"profile18\":\"Account deactivated. Please log in again.\",\"profile19\":\"Are you sure you want to log out the account?\",\"profile20\":\"Reconsider\",\"profile21\":\"Confirm\",\"profile22\":\"Account suspended.\",\"profile23\":\"The UID has been copied to the clipboard\",\"profile24\":\"Copy failed\",\"profile25\":\"Logout failed. Please try again.\",\"profile26\":\"and\",\"profile27\":\"My Wallet\",\"profile28\":\"Top Up\",\"profile29\":\"Please use the same login method for the Netshort app.\",\"profile162\":\"Weekly VIP\",\"profile163\":\"Monthly VIP\",\"profile165\":\"Yearly VIP\",\"profile164\":\"Seasonly VIP\",\"consentRequired\":\"Please agree to the User Agreement and Privacy Policy.\"},\"episode\":{\"watch\":\"...Watch \",\"more\":\" for free on NetShort. Discover more popular short dramas.\",\"featuredReviews\":\"Ep Review\",\"view_more\":\"More\",\"short_drama_404_text\":\"\",\"guestConsumedModal\":{\"message\":\"You completed payment as a guest. To avoid losing your order info, please log in and link your account now.\"},\"paySuccessModal\":{\"bindNow\":\"Link Now\",\"vipTitle\":\"Congratulations! You are now a VIP member!\",\"vipDesc\":\"Download NetShort and log in to watch 2,000+ premium dramas, experience HD streaming, and explore more exclusive content and features!\",\"rechargeSuccessTitle\":\"Congratulations! Your top-up was successful!\",\"rechargeSuccessDownloadAfterConsume\":\"Payment Successful! Download NetShort \u0026 log in to continue watching.\",\"rechargeSuccessDownloadWithBalance\":\"Payment Successful! Download NetShort \u0026 log in to use your coins for more content.\"},\"unlockEpisode\":\"Unlock This Episode\",\"payModal\":{\"rechargeInstructions\":\"Top-up Policy\",\"rechargeContent_1\":\"1. Membership benefits, coins, and bonus obtained from top-ups can be used to unlock paid content within the NetShort app.\",\"rechargeContent_2\":\"2. You may top up for yourself or for another user with a known UID; after payment, membership benefits or coins and bonus will be automatically credited to the designated account.\",\"rechargeContent_3\":\"3. Bonus will expire after a specified period; please check the expiration date in \\\"My Wallet\\\".\",\"rechargeContent_4\":\"4. Subscription promotions take effect within 24 hours after purchase, depending on your payment status. The system will automatically charge your account based on your selected plan within 24 hours before the current subscription ends.\",\"rechargeContent_5\":\"5. Once payment is successful, your subscription will automatically renew. To cancel auto-renewal, please do so in Profile at least 24 hours in advance.\",\"rechargeContent_6\":\"6. If you have any questions, please contact us via email promptly.\",\"rechargeContent_7\":\"By purchasing coins or subscribing, you agree to our Terms of Service; payments will be processed securely.\",\"membershipAgreement\":\"Membership Agreement\",\"paymentAgreement\":\"Payment Agreement\",\"privacyAgreement\":\"Privacy Policy\",\"price\":\"Price\",\"balance\":\"Balance\",\"toPay\":\"Proceed to Payment\",\"subscriptionAutoRenewDesc\":\"Auto-renews, cancel anytime\",\"subscriptionPriceWeek\":\"{x1}/week for the first {x2} weeks, then {x3}/week\",\"subscriptionPriceMonth\":\"{x1}/month for the first {x2} months, then {x3}/month\",\"subscriptionPriceQuarter\":\"{x1}/season for the first {x2} seasons, then {x3}/season\",\"subscriptionPriceYear\":\"{x1}/year for the first {x2} years, then {x3}/year\",\"cardPaySheetTitle\":\"Pay with debit or credit card\",\"chooseTip\":\"Select Payment Method\",\"pay\":\"Pay\",\"cardPay\":\"Card Payment\"},\"payFailedModal\":{\"title\":\"Payment Failed\",\"desc\":\"Sorry, please try again\",\"tryAgain\":\"Retry\",\"back\":\"Back\"},\"lockPopDownload\":{\"getButton\":\"Get\",\"description\":\"Watch paid episodes in the app\"},\"browserUnsupportedCover\":\"Recommended to watch using Chrome browser\",\"episodeList\":\"Episode List\",\"synopsis\":\"Synopsis\"},\"expired_tip_text\":\"Short drama removed\",\"downloadPopup\":{\"text\":\"Scan the QR code to get NetShort and start binging.\",\"closeAria\":\"Off\",\"ariaLabel\":\"Download the NetShort App\"},\"user\":{\"reportThankYou\":\"Report submitted\",\"report\":\"Report\",\"expirationTime\":\"Expiration Date: {xx}/{xx}/{xx}\",\"autoRenewal\":\"Auto-Renewal\",\"disableAutoRenewalConfirmBtn\":\"Confirm\",\"disableAutoRenewalCancelBtn\":\"Cancel\",\"activate\":\"Subscribe\",\"title\":\"Profile\",\"titleNotLoggedIn\":\"Profile – Not Logged In\",\"autoRenewalCancelTip\":\"Notice: To cancel your subscription, please turn off auto-renewal at least 24 hours in advance.\",\"disableAutoRenewalTitle\":\"Turn Off Auto-Renewal\",\"disableAutoRenewalConfirmContent\":\"Confirm turning off auto-renewal? You will no longer be charged automatically\",\"disableAutoRenewalSuccess\":\"Auto-renewal has been turned off\",\"disableAutoRenewalFail\":\"Failed. Please try again later\",\"netshortVip\":\"NetShort VIP\",\"enjoyExclusiveBenefits\":\"Exclusive VIP Benefits\",\"active\":\"Activated\",\"vipCancelTimeLabel\":\"Auto-Renewal Cancellation Date\",\"renewalManagement\":\"Subscription Management\",\"reportPlaceholder\":\"Enter here.\",\"reporting\":\"Submitting report...\"},\"short_search_title\":\"You're searching for \u003cname\u003e\u003c/name\u003e. Here are some picks for you:\",\"short_search_desc\":\"Browse the short dramas related to \u003cname\u003e\u003c/name\u003e and find the one for you. Every plot detail is crafted, paired with outstanding performances, to bring you an immersive cinematic experience. Explore the selection below to discover the unique charm of short dramas and enjoy a captivating feast!\",\"short_search_seo_desc\":\"Welcome to NetShort! We've picked a collection of {search_name} short dramas just for you. Top {search_name} hits include {short_name1}, {short_name2}, and {short_name3}. Packed with twists, totally addictive. Binge away!\",\"short_search_seo_title\":\"{search_name} -All Episodes Free - NetShort\",\"cookie\":{\"banner\":{\"title\":\"Your privacy matters\",\"description\":\"We use cookies to improve your browsing experience, analyse traffic, and provide relevant content. You can accept all cookies, reject non-essential cookies, or manage your cookie settings. For more information, please read our \u003ccookiePolicy\u003eCookie Policy\u003c/cookiePolicy\u003e.\",\"cookieSettings\":\"Cookie Settings\",\"rejectAll\":\"Reject All\",\"acceptAll\":\"Accept All\",\"closeAria\":\"Close\"},\"settings\":{\"title\":\"Privacy Overview\",\"intro\":\"This website uses only essential cookies to ensure proper functionality and a smooth browsing experience. These cookies are stored in your browser and are necessary for the basic operations of the site. No non-essential or third-party cookies are used.\",\"categories\":{\"necessary\":\"Necessary\",\"functionality\":\"Functionality\",\"analytics\":\"Analytics\",\"advertising\":\"Advertising\",\"functional\":\"Functionality\"},\"categoryDescriptions\":{\"necessary\":\"Cookies used to: - determine whether the user has accepted the cookies consent box; - register whether or not the user has viewed the website's privacy policy; - distinguish between humans and bots (robots).\",\"functionality\":\"Functional cookies help perform certain functionalities like sharing the content of the website on social media platforms, collecting feedback, and other third-party features.\",\"analytics\":\"Cookies used to analyze website traffic and understand how visitors interact with the site. These cookies are disabled until the user gives their consent.\",\"advertising\":\"Cookies used to deliver personalized advertisements and measure the effectiveness of advertising campaigns. These cookies are disabled until the user gives their consent.\"},\"alwaysActive\":\"Always Active\",\"table\":{\"cookie\":\"Cookie\",\"duration\":\"Duration\",\"description\":\"Description\"},\"cookies\":{\"GRECAPTCHA\":{\"duration\":\"6 months\",\"description\":\"Google Recaptcha service sets this cookie to identify bots to protect the website against malicious spam attacks.\"}},\"acceptAll\":\"Accept All\",\"closeAria\":\"Close\"}},\"deleteAccount\":{\"entry\":\"Delete account\",\"instructions\":{\"title\":\"Account Deletion Instructions\",\"item1\":\"Before you decide to delete your account, please carefully read the following instructions to ensure that you fully understand the consequences of account deletion.\",\"item2\":\"Account Deletion Is Irreversible: Once you confirm the deletion of your account, your account and all related information will be permanently removed and cannot be recovered.\\nPlease proceed with caution.\",\"item3\":\"Data Erasure: After your account is deleted, the following information will be permanently erased and cannot be restored: personal data; third-party account information; purchase history, including top-up history, episode unlock history, and series in My List; and account balance, including Coins and bonus VIP benefits.\",\"item4\":\"Auto-Renewing VIP Subscription: If you have purchased an auto-renewing VIP subscription and your account currently has VIP status, deleting your account will be considered a voluntary forfeiture of your VIP benefits. To avoid further charges, please cancel your subscription through the Google Play Store or the Apple App Store before deleting your account. NetShort will not be responsible for any continued charges resulting from failure to cancel the subscription.\",\"consent\":\"I accept all risks associated with deleting my account and agree to its deletion.\",\"acceptAll\":\"Accept all\"},\"confirm\":{\"title\":\"Confirm Account Deletion\",\"confirm\":\"Confirm\",\"cancel\":\"Cancel\"},\"successModal\":{\"description\":\"Your account has been deleted, and all related information has been permanently removed from our system. If you wish to continue using NetShort, please reopen the app or visit the website.\",\"tryAgain\":\"Try again\"}},\"short_search_longtail\":\"Related Searches\",\"allepisodes\":{\"title\":\"Full Episodes, Full Movies \u0026 Good Web Series on NetShort\"},\"faq\":{\"meta\":{\"title\":\"NetShort FAQ\",\"description\":\"Answers about NetShort short dramas, micro dramas, reels shorts, watching series online, HD, downloads, and support.\"},\"h1\":{\"title\":\"FAQ\"},\"q1\":{\"question\":\"What is NetShort?\",\"answer\":{\"aHtml\":\"NetShort is a place to watch \u003clink\u003eshort dramas\u003c/link\u003e and micro dramas online — including NetShort originals and officially licensed series. Think binge-friendly short reels and reels shorts, not a random dump of full-length films. You can watch on our website or grab the \u003clink2\u003eNetShort app\u003c/link2\u003e on Android and iOS.\"}},\"q2\":{\"question\":\"Are NetShort episodes free to watch?\",\"answer\":{\"aHtml\":\"A lot of episodes are free to start. Early episodes on many series are unlocked at no cost; later ones may need coins, a subscription, ads, or VIP. So yes — you can \u003clink\u003ewatch series online\u003c/link\u003e for free in many cases, while premium unlocks help you finish trending titles without stopping halfway.\"}},\"q3\":{\"question\":\"Where can I watch NetShort dramas?\",\"answer\":{\"aHtml\":\"Wherever’s easiest for you. On a computer, go to \u003chome\u003enetshort.com\u003c/home\u003e; on your phone browser, use \u003cwebMobile\u003eweb.shortnivo.com\u003c/webMobile\u003e. Prefer an app? \u003cdownload\u003eDownload NetShort\u003c/download\u003e for iOS or Android. That’s the simplest way to watch series online, keep your list, and pick up where you left off.\"}},\"q4\":{\"question\":\"Are your dramas available in multiple languages?\",\"answer\":{\"aHtml\":\"Yes — we support 17 languages, including English, Traditional Chinese, Simplified Chinese, Thai, Indonesian, Japanese, Korean, Spanish, Arabic, Portuguese, Italian, German, French, Turkish, Malay, Vietnamese, and Hindi. Each version has localized \u003callPlots\u003eshort dramas\u003c/allPlots\u003e and short videos; audio and subtitles can still vary by title and region.\"}},\"q5\":{\"question\":\"Can I watch NetShort dramas in 1080p HD quality?\",\"answer\":{\"aHtml\":\"Yes. On web and in the \u003cdownload\u003eapp\u003c/download\u003e you can stream in crisp 1080p HD — great when you want that “\u003chotseries\u003egood web series\u003c/hotseries\u003e / HD” feel on a bigger screen. HD playback is available for VIP members so the picture stays clear whether you’re on short reels or a longer binge.\"}},\"q6\":{\"question\":\"How often are new short dramas and episodes released?\",\"answer\":{\"aHtml\":\"Pretty often. We add new \u003callEpisodes\u003eshort dramas\u003c/allEpisodes\u003e, \u003chotseries\u003eexclusive titles\u003c/hotseries\u003e, and fresh episodes on a regular basis, so there’s usually something new if you like short series, micro dramas, or quick reels shorts between tasks.\"}},\"q7\":{\"question\":\"Can I download episodes to watch offline?\",\"answer\":{\"aHtml\":\"Usually in the \u003cdownload\u003eNetShort app\u003c/download\u003e (not always on the website). Open a series in the app and look for download if that title and your account support it — handy when you want short videos or full episode packs without relying on Wi‑Fi.\"}},\"q8\":{\"question\":\"How can businesses partner with NetShort for content creation?\",\"answer\":{\"aHtml\":\"We work with creators, studios, and brands on micro dramas production, IP licensing, and brand integrations — including watch the originals-style \u003chotseries\u003eNetShort Exclusive\u003c/hotseries\u003e projects. Reach out through the partnership contacts on our \u003chome\u003ewebsite\u003c/home\u003e and tell us what you’re building.\"}},\"q9\":{\"question\":\"How do I get help or report a problem?\",\"answer\":{\"aHtml\":\"Fastest option: in-app profile feedback. Or email the \u003csupport\u003esupport addresses\u003c/support\u003e in the website footer. Include your NetShort ID or registered email, device, app version, and a short description of what went wrong (page URL helps too if you were trying to \u003callEpisodes\u003ewatch series online\u003c/allEpisodes\u003e).\"}}}},\"children\":\"$L14\"}]\n"])</script><script>self.__next_f.push([1,"14:[\"$\",\"$L15\",null,{\"isPcLayout\":true,\"userAgent\":\"DramadexBot/0.1 (self-hosted metadata indexer)\",\"children\":[[\"$\",\"$L16\",null,{}],[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[\"$L17\",[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}]\nc:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n8:null\n"])</script><script>self.__next_f.push([1,"a:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\" Full Movie - NetShort\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\" on NetShort and enjoy the drama anytime, anywhere.\"}],[\"$\",\"meta\",\"2\",{\"name\":\"keywords\",\"content\":\"Short Drama, Drama Movies, Films, Short Video, Drama Story, Netshort\"}],[\"$\"