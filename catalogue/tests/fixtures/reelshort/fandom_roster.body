<script src="https://v-mps.crazymaplestudios.com/images/55bf15f0-5fe2-11f1-b0e9-f1e04973cf14.js"></script>
<script>
  function toggleSection(sectionId) {
    const section = document.getElementById(sectionId);
    const arrow = section.previousElementSibling.querySelector('.arrow');

    if (section.style.maxHeight) {
      section.style.maxHeight = null;
      arrow.style.transform = 'rotate(0deg)';
    } else {
      section.style.maxHeight = section.scrollHeight + 'px';
      arrow.style.transform = 'rotate(180deg)';
    }
  }

  // 存储从 iframe postMessage 接收到的剧集信息
  let _bookInfo = null;
  const _hasPlayer = !!document.getElementById('reelshort_player');

  function buildInstallUrl(baseUrl) {
    if (!_bookInfo) return baseUrl;
    const pairs = [
      ['b', _bookInfo.book_id],
      ['c', _bookInfo.chapter_id],
      ['o', _bookInfo.serial_number],
      ['t', _bookInfo.book_type],
      ['j', _bookInfo.chapter_id],
      ['s', _bookInfo.s_book_id],
    ].filter(function(p) { return p[1] != null && p[1] !== ''; });
    if (!pairs.length) return baseUrl;
    return baseUrl + '&' + pairs.map(function(p) { return p[0] + '=' + encodeURIComponent(p[1]); }).join('&');
  }

  function applyInstallUrls() {
    document.querySelectorAll('[data-install-url]').forEach(function(el) {
      if (!el.dataset.baseInstallUrl) {
        el.dataset.baseInstallUrl = el.getAttribute('data-install-url');
      }
      el.setAttribute('data-install-url', buildInstallUrl(el.dataset.baseInstallUrl));
      // 清除已渲染标记，允许根据新 URL 重新生成二维码
      if (el.hasAttribute('data-rs-qr')) {
        el.removeAttribute('data-rs-qr-done');
      }
    });
    // 重新渲染所有二维码
    if (window.RSDynamicQR) {
      window.RSDynamicQR.init(document);
    }
  }

  function toApp() {
    CmsfeTools?.fn?.toApp(_bookInfo ? {
      book_id: _bookInfo.book_id,
      chapter_id: _bookInfo.chapter_id,
      serial_number: _bookInfo.serial_number,
      book_type: _bookInfo.book_type,
      s_book_id: _bookInfo.s_book_id,
      t_book_id: _bookInfo.t_book_id,
    } : undefined);
  }

  document.addEventListener('DOMContentLoaded', function() {
    const sections = document.querySelectorAll('.section-content');
    sections.forEach((section) => {
      section.style.maxHeight = null;
    });

    const floatingQrcode = document.querySelector('[data-floating-qrcode]');
    if (floatingQrcode) {
      const closeButton = floatingQrcode.querySelector('[data-floating-qrcode-close]');
      const toggleButton = floatingQrcode.querySelector('[data-floating-qrcode-toggle]');

      const handleKeyboardClick = function(event, callback) {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          callback();
        }
      };

      const reportQrcodeEvent = function(action) {
        CmsfeTools?.fn?.eventReport({
          event_name: 'm_custom_event',
          sub_event_name: 'side_qrcode_click',
          properties: {
            _action: action,
            _url: window.location.href,
          },
        });
      };

      const closeFloatingQrcode = function() {
        floatingQrcode.classList.remove('is-open');
        toggleButton?.focus();
        reportQrcodeEvent('close');
      };

      const openFloatingQrcode = function() {
        floatingQrcode.classList.add('is-open');
        closeButton?.focus();
        reportQrcodeEvent('click');
      };

      closeButton?.addEventListener('click', closeFloatingQrcode);
      closeButton?.addEventListener('keydown', function(event) {
        handleKeyboardClick(event, closeFloatingQrcode);
      });

      toggleButton?.addEventListener('click', openFloatingQrcode);
      toggleButton?.addEventListener('keydown', function(event) {
        handleKeyboardClick(event, openFloatingQrcode);
      });
    }
  });
  // 在脚本开始处添加翻译数据
  const translatedData = {
    qrCodeUrl: `https://v-mps.crazymaplestudios.com/images/66464f10-541b-11f1-b0e9-f1e04973cf14.png`,
    installUrl: `https://www.reelshort.com/independent/install?p=a`,
    scanText: `In-App Exclusive: Free Unlocks`,
    downloadText: `Download`
  };

  function initPage() {
    // 更新所有 data-install-url（含 sidebar 动态生成的元素）
    applyInstallUrls();

    // 修改后的二维码区块
    const sidebarQrcode = document.querySelector('.sidebar-qrcode');
    if (sidebarQrcode) {
      const sidebarInstallUrl = buildInstallUrl(translatedData.installUrl);
      sidebarQrcode.innerHTML = `<div class="wp-block-group">
      <h2 class="wp-block-heading has-text-align-center">${translatedData.downloadText}</h2>
      <div style="text-align: center; padding: 20px 0">
        <img
          class="rs-qr-img"
          data-rs-qr
          data-base-install-url="${translatedData.installUrl}"
          data-install-url="${sidebarInstallUrl}"
          src="${translatedData.qrCodeUrl}"
          style="
            width: 120px;
            height: 120px;
            margin: 0 auto;
            margin-bottom: 20px;
            border: 1px solid #ccc;
          "
        />
        <p
          style="
            color: #757575;
            text-align: center;
            font-size: 14px;
            font-style: normal;
            font-weight: 500;
            line-height: 130%;
            max-width: 238px;
            margin: 0 auto;
          "
        >
          ${translatedData.scanText}
        </p>
      </div>
    </div>`;
      if (window.RSDynamicQR) {
        window.RSDynamicQR.init(sidebarQrcode);
      }
    }

    CmsfeTools?.fn?.installEvent();
  }

  // 立即初始化（先用基础 URL 渲染二维码）
  initPage();

  // 有 iframe 时监听 BOOK_INFO，收到后更新 URL 并刷新二维码
  if (_hasPlayer) {
    window.addEventListener('message', function(event) {
      if (!event.data || event.data.type !== 'BOOK_INFO') return;
      _bookInfo = event.data;
      applyInstallUrls();
    });
  }
</script>

</body>

</html>
