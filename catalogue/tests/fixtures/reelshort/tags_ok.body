quality%2Cq_70 1x, https://v-img.crazymaplestudios.com/v-images/book_cover_batch/200000000000000257/427c59f6-9b97-42a2-a4bc-2fd338b1d926.jpg?x-oss-process=image%2Fresize%2Cw_640%2Fquality%2Cq_70 2x" src="https://v-img.crazymaplestudios.com/v-images/book_cover_batch/200000000000000257/427c59f6-9b97-42a2-a4bc-2fd338b1d926.jpg?x-oss-process=image%2Fresize%2Cw_640%2Fquality%2Cq_70" decoding="async" data-nimg="intrinsic" style="position:absolute;top:0;left:0;bottom:0;right:0;box-sizing:border-box;padding:0;border:none;margin:auto;display:block;width:0;height:0;min-width:100%;max-width:100%;min-height:100%;max-height:100%;object-fit:cover" loading="lazy"/></noscript></span></a></div><div class="min-w-0 flex flex-col justify-between overflow-hidden md:flex-1 md:p-20px"><div><h2 class="line-clamp-2 break-words text-white/90 font-500 leading-[normal] text-14/vw md:line-clamp-1 md:text-16px md:text-white/80 md:font-400"><a href="/movie/the-adjuster-6825b32759426343470c833f">The Adjuster</a></h2><div class="flex text-white/50 mt-8/vw text-12/vw md:mt-8px md:text-12px md:hidden"><div class="flex items-center mr-16/vw md:mr-24px"><span class="mr-2/vw text-12/vw md:mr-2px md:text-16px"><span role="img" class="anticon"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false" class=""><path fill="currentColor" fill-opacity="0.9" d="M4.488 7.04c.817-4.063 2.618-4.91 6.539-3.218a31.933 31.933 0 0 1 7.617 4.624c3.141 2.58 3.141 4.423 0 7.003a31.936 31.936 0 0 1-7.617 4.624c-3.92 1.692-5.722.845-6.54-3.218a24.93 24.93 0 0 1 0-9.815"></path></svg></span></span>14.1M</div><div class="flex items-center"><span class="mr-2/vw text-12/vw md:mr-2px md:text-16px"><span role="img" class="anticon"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 32 32" width="1em" height="1em" aria-hidden="true" focusable="false" class=""><path fill="currentColor" d="M5.053 6.143a2.476 2.476 0 0 1 2.476-2.476H24.47a2.476 2.476 0 0 1 2.477 2.476v21.251c0 .98-1.086 1.572-1.91 1.04l-7.695-4.964a2.476 2.476 0 0 0-2.685 0l-7.696 4.965a1.238 1.238 0 0 1-1.91-1.04z"></path></svg></span></span>176.5k</div></div><div class="rich-text inner-html-clamp line-clamp-2 break-words text-white/50 leading-[normal] mt-8/vw text-12/vw md:mt-12px md:text-12px cursor-pointer md:line-clamp-2">In The Adjuster movie, after his sister dies due to losing health coverage, Matteo Leone, a broken man, takes justice into his own hands by killing the insurance company CEO. But he isn't just out for revenge, he has a bigger goal: Expose corrupt health insurance companies for preying on their most vulnerable customers. Matteo stays one step ahead of the police, leaving a trail of clues to send his message, soon becoming a hero to the people the evil CEO's thought they could silence.</div></div><div class="flex justify-between hidden md:flex md:items-end"><div class="flex text-white/50 mt-8/vw text-12/vw md:mt-0 md:text-14px"><div class="flex items-center mr-24/vw md:mr-24px"><span class="mr-2/vw text-12/vw md:mr-2px md:text-16px"><span role="img" class="anticon"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false" class=""><path fill="currentColor" fill-opacity="0.9" d="M4.488 7.04c.817-4.063 2.618-4.91 6.539-3.218a31.933 31.933 0 0 1 7.617 4.624c3.141 2.58 3.141 4.423 0 7.003a31.936 31.936 0 0 1-7.617 4.624c-3.92 1.692-5.722.845-6.54-3.218a24.93 24.93 0 0 1 0-9.815"></path></svg></span></span>14.1M</div><div class="flex items-center"><span class="mr-2/vw text-14/vw md:mr-2px md:text-16px"><span role="img" class="anticon"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 32 32" width="1em" height="1em" aria-hidden="true" focusable="false" class=""><path fill="currentColor" d="M5.053 6.143a2.476 2.476 0 0 1 2.476-2.476H24.47a2.476 2.476 0 0 1 2.477 2.476v21.251c0 .98-1.086 1.572-1.91 1.04l-