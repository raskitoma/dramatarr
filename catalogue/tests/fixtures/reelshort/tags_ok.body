-4.964a2.476 2.476 0 0 0-2.685 0l-7.696 4.965a1.238 1.238 0 0 1-1.91-1.04z"></path></svg></span></span>240.3k</div></div><div class="rich-text inner-html-clamp line-clamp-2 break-words text-white/50 leading-[normal] mt-8/vw text-12/vw md:mt-12px md:text-12px cursor-pointer md:line-clamp-2">In Alpha Mate Unchained movie, he killed his vicious father to save her.  Now the new Alpha King must hide his fated mate and use a decoy fake Luna to keep her alive. But while he’s away battling, she’s discovered by the Fake Luna and brutally tortured.  Can she survive long enough for the Alpha King’s return and vengeance?</div></div><div class="flex justify-between hidden md:flex md:items-end"><div class="flex text-white/50 mt-8/vw text-12/vw md:mt-0 md:text-14px"><div class="flex items-center mr-24/vw md:mr-24px"><span class="mr-2/vw text-12/vw md:mr-2px md:text-16px"><span role="img" class="anticon"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false" class=""><path fill="currentColor" fill-opacity="0.9" d="M4.488 7.04c.817-4.063 2.618-4.91 6.539-3.218a31.933 31.933 0 0 1 7.617 4.624c3.141 2.58 3.141 4.423 0 7.003a31.936 31.936 0 0 1-7.617 4.624c-3.92 1.692-5.722.845-6.54-3.218a24.93 24.93 0 0 1 0-9.815"></path></svg></span></span>28.6M</div><div class="flex items-center"><span class="mr-2/vw text-14/vw md:mr-2px md:text-16px"><span role="img" class="anticon"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 32 32" width="1em" height="1em" aria-hidden="true" focusable="false" class=""><path fill="currentColor" d="M5.053 6.143a2.476 2.476 0 0 1 2.476-2.476H24.47a2.476 2.476 0 0 1 2.477 2.476v21.251c0 .98-1.086 1.572-1.91 1.04l-7.695-4.964a2.476 2.476 0 0 0-2.685 0l-7.696 4.965a1.238 1.238 0 0 1-1.91-1.04z"></path></svg></span></span>240.3k</div></div><button role="play_btn" class="flex-center font-bold h-30/vw min-w-107/vw px-10/vw rounded-4/vw text-14/vw transition-c