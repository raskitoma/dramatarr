51\",\"static/chunks/5751-fef6912a7c98bd8e.js\",\"1696\",\"static/chunks/1696-9e91d782d1d12c68.js\",\"7047\",\"static/chunks/7047-c0f1eadfb9511a66.js\",\"4345\",\"static/chunks/app/not-found-25a6839a5f071917.js\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"17:[\"$\",\"$L29\",null,{\"list\":[{\"shortPlayLibraryId\":\"2090980780014141441\",\"shortPlayId\":\"2090980782421671938\",\"shortPlayName\":\"Crushing The Village Bully\",\"shortPlayNameNoHL\":\"Crushing The Village Bully\",\"shortPlayNameUrl\":\"/episode/crushing-the-village-bully-2090980782421671938\",\"fullEpisodeNameUrl\":\"/full-episodes/crushing-the-village-bully-2090980782421671938\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090980780014141441/1787552403219-1281685474716605-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"During a deadly drought, a ruthless local bully cuts off the village's only water supply just to farm crabs! While the desperate villagers beg for mercy, a mysterious hero makes a badass return. Refusing to back down, he steps up to crush the arrogant bully, reclaim their lifeline, and restore ultimate justice!\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"},{\"labelId\":\"1983832035958800386\",\"labelName\":\"Inheritance Battle\",\"labelNameUrl\":\"/drama/Inheritance%20Battle-1983832035958800386\",\"language\":\"en\"},{\"labelId\":\"1983832036969627650\",\"labelName\":\"Rural Life\",\"labelNameUrl\":\"/drama/Rural%20Life-1983832036969627650\",\"language\":\"en\"}],\"totalEpisode\":24},{\"shortPlayLibraryId\":\"2090980411771027457\",\"shortPlayId\":\"2090980414908366849\",\"shortPlayName\":\"That's My House!\",\"shortPlayNameNoHL\":\"That's My House!\",\"shortPlayNameUrl\":\"/episode/thats-my-house-2090980414908366849\",\"fullEpisodeNameUrl\":\"/full-episodes/thats-my-house-2090980414908366849\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090980411771027457/1787552920338-2512705420596164-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"A woman drains her savings to build a house for her fiancé's family, only to discover the deeds are registered under his brother's name. They assume she will accept it. She collects the receipts, calls the trucks, and on the day of the engagement, she tears down the gates.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092291883010\",\"labelName\":\"Karma Payback\",\"labelNameUrl\":\"/drama/Karma%20Payback-1983832092291883010\",\"language\":\"en\"},{\"labelId\":\"1983832092975554563\",\"labelName\":\"Romantic Marriage\",\"labelNameUrl\":\"/drama/Romantic%20Marriage-1983832092975554563\",\"language\":\"en\"},{\"labelId\":\"1983832092950388739\",\"labelName\":\"Female Empowerment\",\"labelNameUrl\":\"/drama/Female%20Empowerment-1983832092950388739\",\"language\":\"en\"}],\"totalEpisode\":37},{\"shortPlayLibraryId\":\"2090978270394286082\",\"shortPlayId\":\"2090978272910868481\",\"shortPlayName\":\"Athena：Medusa, love me once more\",\"shortPlayNameNoHL\":\"Athena：Medusa, love me once more\",\"shortPlayNameUrl\":\"/episode/athenamedusa-love-me-once-more-2090978272910868481\",\"fullEpisodeNameUrl\":\"/full-episodes/athenamedusa-love-me-once-more-2090978272910868481\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090978270394286082/1787559101891-4062970507392603-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Driven by hatred for Athena, who cursed her into a serpent, Medusa is cast into the mortal world with her, one forgetting, one remembering. When Medusa's memories return, she seeks revenge but falls for Athena instead. As the truth behind the curse emerges, Poseidon's wrath forces them to face a final choice.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092417712131\",\"labelName\":\"Fantasy Romance\",\"labelNameUrl\":\"/drama/Fantasy%20Romance-1983832092417712131\",\"language\":\"en\"},{\"labelId\":\"1983832091029397505\",\"labelName\":\"Wish-Fulfillment\",\"labelNameUrl\":\"/drama/Wish-Fulfillment-1983832091029397505\",\"language\":\"en\"},{\"labelId\":\"1983832090932928513\",\"labelName\":\"Alternate History\",\"labelNameUrl\":\"/drama/Alternate%20History-1983832090932928513\",\"language\":\"en\"}],\"totalEpisode\":54},{\"shortPlayLibraryId\":\"2089638351519547394\",\"shortPlayId\":\"2089638355348946946\",\"shortPlayName\":\"Widow at the Night Market\",\"shortPlayNameNoHL\":\"Widow at the Night Market\",\"shortPlayNameUrl\":\"/episode/widow-at-the-night-market-2089638355348946946\",\"fullEpisodeNameUrl\":\"/full-episodes/widow-at-the-night-market-2089638355348946946\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089638351519547394/1787544748117-9859219338803981-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Bullied at the Night Market, Wendy Lynn must keep her sick Mother-in-law and young daughter alive. When ruthless vendor Clara Chang tries to drive her out, Wendy Lynn fights back and turns a tiny stall into a hit shop. Shaw stays by her side even after she rejects him, but just as she’s about to turn things around, Clara Chang makes her next move.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832091864064002\",\"labelName\":\"Slow-Burn Romance\",\"labelNameUrl\":\"/drama/Slow-Burn%20Romance-1983832091864064002\",\"language\":\"en\"},{\"labelId\":\"1983832092950388739\",\"labelName\":\"Female Empowerment\",\"labelNameUrl\":\"/drama/Female%20Empowerment-1983832092950388739\",\"language\":\"en\"},{\"labelId\":\"1984208314792402946\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1984208314792402946\",\"language\":\"en\"}],\"totalEpisode\":52},{\"shortPlayLibraryId\":\"2091347977610063874\",\"shortPlayId\":\"2091347980437024769\",\"shortPlayName\":\"Love in disloyalty\",\"shortPlayNameNoHL\":\"Love in disloyalty\",\"shortPlayNameUrl\":\"/episode/love-in-disloyalty-2091347980437024769\",\"fullEpisodeNameUrl\":\"/full-episodes/love-in-disloyalty-2091347980437024769\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2091347977610063874/1787566926154-7554117153375707-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"A man who loved his best friend's wife for years finally gets his chance when she discovers her husband's infidelity. One night of revenge turns into a secret affair that neither can walk away from. She started as a friend's wife. She became his reason to stay.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092736479234\",\"labelName\":\"Modern Romance\",\"labelNameUrl\":\"/drama/Modern%20Romance-1983832092736479234\",\"language\":\"en\"},{\"labelId\":\"1983832090844848130\",\"labelName\":\"Modern\",\"labelNameUrl\":\"/drama/Modern-1983832090844848130\",\"language\":\"en\"}],\"totalEpisode\":56},{\"shortPlayLibraryId\":\"2091347339606085634\",\"shortPlayId\":\"2091347342122668034\",\"shortPlayName\":\"Addicted to My CEO Doctor\",\"shortPlayNameNoHL\":\"Addicted to My CEO Doctor\",\"shortPlayNameUrl\":\"/episode/addicted-to-my-ceo-doctor-2091347342122668034\",\"fullEpisodeNameUrl\":\"/full-episodes/addicted-to-my-ceo-doctor-2091347342122668034\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2091347339606085634/1787565417138-5643692207909003-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Neglected by her husband who loves her sister, a lonely wife develops a secret condition. She seeks help from a handsome doctor, only to find out he is her new billionaire boss! As he fiercely protects her from her toxic family's wicked schemes, their private office sessions turn into a forbidden romance. Will she leave her terrible marriage?\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092291883010\",\"labelName\":\"Karma Payback\",\"labelNameUrl\":\"/drama/Karma%20Payback-1983832092291883010\",\"language\":\"en\"},{\"labelId\":\"1983832092736479234\",\"labelName\":\"Modern Romance\",\"labelNameUrl\":\"/drama/Modern%20Romance-1983832092736479234\",\"language\":\"en\"},{\"labelId\":\"1983832092950388739\",\"labelName\":\"Female Empowerment\",\"labelNameUrl\":\"/drama/Female%20Empowerment-1983832092950388739\",\"language\":\"en\"}],\"totalEpisode\":40},{\"shortPlayLibraryId\":\"2090980020610236417\",\"shortPlayId\":\"2090980023906959362\",\"shortPlayName\":\"Return Of The Tyrant's Dead Crush\",\"shortPlayNameNoHL\":\"Return Of The Tyrant's Dead Crush\",\"shortPlayNameUrl\":\"/episode/return-of-the-tyrants-dead-crush-2090980023906959362\",\"fullEpisodeNameUrl\":\"/full-episodes/return-of-the-tyrants-dead-crush-2090980023906959362\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090980020610236417/1787560571190-9061439165050986-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"She transmigrated into a novel as the only woman beside a tyrant. Her mission: become his white moonlight. She taught him to love, then left. The system failed. It sent her three years into the future. The tyrant she taught to love has learned a new lesson: how to hate. Can she survive the heart she created?\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092962971651\",\"labelName\":\"Historical Romance\",\"labelNameUrl\":\"/drama/Historical%20Romance-1983832092962971651\",\"language\":\"en\"},{\"labelId\":\"1983832092468043778\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832092468043778\",\"language\":\"en\"},{\"labelId\":\"1983832092174442499\",\"labelName\":\"Trapped in a Book\",\"labelNameUrl\":\"/drama/Trapped%20in%20a%20Book-1983832092174442499\",\"language\":\"en\"}],\"totalEpisode\":64},{\"shortPlayLibraryId\":\"2090979531348869121\",\"shortPlayId\":\"2090979534293270529\",\"shortPlayName\":\"My Ex Is an Alpha, My Future Is a King\",\"shortPlayNameNoHL\":\"My Ex Is an Alpha, My Future Is a King\",\"shortPlayNameUrl\":\"/episode/my-ex-is-an-alpha-my-future-is-a-king-2090979534293270529\",\"fullEpisodeNameUrl\":\"/full-episodes/my-ex-is-an-alpha-my-future-is-a-king-2090979534293270529\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090979531348869121/1787567438191-6881346965498211-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"When the Duke dies, Cordelia’s uncle steals the title and fortune, leaving her blind and powerless. To protect her lover Luke, she breaks his heart and sends him away. Years later, Luke returns as Duke Luciano, a feared war hero seeking revenge. But as the truth unfolds, hatred turns into a love he can’t resist.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092417712131\",\"labelName\":\"Fantasy Romance\",\"labelNameUrl\":\"/drama/Fantasy%20Romance-1983832092417712131\",\"language\":\"en\"},{\"labelId\":\"1983832090991648770\",\"labelName\":\"Fantasy World\",\"labelNameUrl\":\"/drama/Fantasy%20World-1983832090991648770\",\"language\":\"en\"},{\"labelId\":\"1984208314792402946\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1984208314792402946\",\"language\":\"en\"}],\"totalEpisode\":40},{\"shortPlayLibraryId\":\"2090979073104384002\",\"shortPlayId\":\"2090979075608383490\",\"shortPlayName\":\"THE PRODIGY RETURNS\",\"shortPlayNameNoHL\":\"THE PRODIGY RETURNS\",\"shortPlayNameUrl\":\"/episode/the-prodigy-returns-2090979075608383490\",\"fullEpisodeNameUrl\":\"/full-episodes/the-prodigy-returns-2090979075608383490\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090979073104384002/1787568483228-4733641097153223-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Reborn after being betrayed and killed by her own family, Ada returns to expose her adopted sister Camilla, who stole her genius and used mind-reading powers to cheat. Once a neglected daughter, Ada now fights back, reclaiming her honor and proving herself as the world’s greatest math prodigy.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092736479234\",\"labelName\":\"Modern Romance\",\"labelNameUrl\":\"/drama/Modern%20Romance-1983832092736479234\",\"language\":\"en\"},{\"labelId\":\"1983832092291883010\",\"labelName\":\"Karma Payback\",\"labelNameUrl\":\"/drama/Karma%20Payback-1983832092291883010\",\"language\":\"en\"}],\"totalEpisode\":60},{\"shortPlayLibraryId\":\"2090978662385553410\",\"shortPlayId\":\"2090978664860192770\",\"shortPlayName\":\"Fleeing The Future I Saw With Him \",\"shortPlayNameNoHL\":\"Fleeing The Future I Saw With Him \",\"shortPlayNameUrl\":\"/episode/fleeing-the-future-i-saw-with-him-2090978664860192770\",\"fullEpisodeNameUrl\":\"/full-episodes/fleeing-the-future-i-saw-with-him-2090978664860192770\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090978662385553410/1787562481210-1637585511241655-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"A girl with future vision sees herself kissing her arrogant, cold student council president. She tries to avoid him, only for him to become her stepbrother overnight. Every vision comes true, and every step brings her closer to the future she was never supposed to want. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092392546307\",\"labelName\":\"Fake Siblings\",\"labelNameUrl\":\"/drama/Fake%20Siblings-1983832092392546307\",\"language\":\"en\"},{\"labelId\":\"1983832093059440642\",\"labelName\":\"Campus Romance\",\"labelNameUrl\":\"/drama/Campus%20Romance-1983832093059440642\",\"language\":\"en\"},{\"labelId\":\"1983832092468043778\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832092468043778\",\"language\":\"en\"}],\"totalEpisode\":40},{\"shortPlayLibraryId\":\"2090977726967676930\",\"shortPlayId\":\"2090977730113404930\",\"shortPlayName\":\"The Furless One\",\"shortPlayNameNoHL\":\"The Furless One\",\"shortPlayNameUrl\":\"/episode/the-furless-one-2090977730113404930\",\"fullEpisodeNameUrl\":\"/full-episodes/the-furless-one-2090977730113404930\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090977726967676930/1787560944340-4028329442558254-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Framed by her pack, Leila was thrown into the Howling Chasm and lost her arm. Two years later, her cruel family forces her to marry the North's rumored \\\"mad wolf\\\", Darian. But Darian is not mad, he is her fiercest protector. When her grandmother reveals that Leila is the true Alpha's daughter, the impostor's schemes collapse...\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832091792760834\",\"labelName\":\"Plot Twist\",\"labelNameUrl\":\"/drama/Plot%20Twist-1983832091792760834\",\"language\":\"en\"},{\"labelId\":\"1983832092153470979\",\"labelName\":\"Werewolf\",\"labelNameUrl\":\"/drama/Werewolf-1983832092153470979\",\"language\":\"en\"},{\"labelId\":\"1983832092417712131\",\"labelName\":\"Fantasy Romance\",\"labelNameUrl\":\"/drama/Fantasy%20Romance-1983832092417712131\",\"language\":\"en\"}],\"totalEpisode\":39},{\"shortPlayLibraryId\":\"2090259073007632385\",\"shortPlayId\":\"2090259075922673665\",\"shortPlayName\":\"THE BILLIONAIRE WHO OWED ME EVERYTHING\",\"shortPlayNameNoHL\":\"THE BILLIONAIRE WHO OWED ME EVERYTHING\",\"shortPlayNameUrl\":\"/episode/the-billionaire-who-owed-me-everything-2090259075922673665\",\"fullEpisodeNameUrl\":\"/full-episodes/the-billionaire-who-owed-me-everything-2090259075922673665\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090259073007632385/1787560324395-5304962620403955-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"After her ex steals her designs and erases her name, talented patternmaker Maya Bennett gets a second chance from billionaire CEO Evelyn Vaughan. Refusing to be controlled, Maya fights to reclaim her identity and rise as a designer. But when a family conspiracy threatens them, Maya and Evelyn must fight together and choose their own destiny.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092950388739\",\"labelName\":\"Female Empowerment\",\"labelNameUrl\":\"/drama/Female%20Empowerment-1983832092950388739\",\"language\":\"en\"},{\"labelId\":\"1984208314792402946\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1984208314792402946\",\"language\":\"en\"}],\"totalEpisode\":40},{\"shortPlayLibraryId\":\"2090256928652935170\",\"shortPlayId\":\"2090256931114991617\",\"shortPlayName\":\"His Empire, My Revenge\",\"shortPlayNameNoHL\":\"His Empire, My Revenge\",\"shortPlayNameUrl\":\"/episode/his-empire-my-revenge-2090256931114991617\",\"fullEpisodeNameUrl\":\"/full-episodes/his-empire-my-revenge-2090256931114991617\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090256928652935170/1787559829008-2861985882531849-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Three years after Scarlett Blake was presumed dead, she returns under a new identity as the largest creditor of Cross Logistics. With a 30-day debt agreement, she takes control of her ex-husband Julian's empire. As buried secrets surface, Scarlett uncovers the conspiracy that nearly killed her and vows to reclaim everything stolen from her.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092270911490\",\"labelName\":\"Revenge\",\"labelNameUrl\":\"/drama/Revenge-1983832092270911490\",\"language\":\"en\"},{\"labelId\":\"1983832092950388739\",\"labelName\":\"Female Empowerment\",\"labelNameUrl\":\"/drama/Female%20Empowerment-1983832092950388739\",\"language\":\"en\"},{\"labelId\":\"1984208314792402946\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1984208314792402946\",\"language\":\"en\"}],\"totalEpisode\":31},{\"shortPlayLibraryId\":\"2090256339277725697\",\"shortPlayId\":\"2090256341798502402\",\"shortPlayName\":\"Reborn, Not Returned\",\"shortPlayNameNoHL\":\"Reborn, Not Returned\",\"shortPlayNameUrl\":\"/episode/reborn-not-returned-2090256341798502402\",\"fullEpisodeNameUrl\":\"/full-episodes/reborn-not-returned-2090256341798502402\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090256339277725697/1787558921463-1973527319241848-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Ivy Green, a noble heiress, gave away her family fortune, health, and reputation to support Lucas Grant and his family for ten years—only to be treated with cold indifference and left to die alone in a snowy winter villa. But fate rewinds: she wakes up three years earlier, on the very day of the aristocratic debutante ball.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832091641765889\",\"labelName\":\"Love After Divorce\",\"labelNameUrl\":\"/drama/Love%20After%20Divorce-1983832091641765889\",\"language\":\"en\"},{\"labelId\":\"1983832092291883010\",\"labelName\":\"Karma Payback\",\"labelNameUrl\":\"/drama/Karma%20Payback-1983832092291883010\",\"language\":\"en\"},{\"labelId\":\"1983832092962971651\",\"labelName\":\"Historical Romance\",\"labelNameUrl\":\"/drama/Historical%20Romance-1983832092962971651\",\"language\":\"en\"}],\"totalEpisode\":31},{\"shortPlayLibraryId\":\"2090738516071387137\",\"shortPlayId\":\"2090738519481356290\",\"shortPlayName\":\"The Bride He Lost\",\"shortPlayNameNoHL\":\"The Bride He Lost\",\"shortPlayNameUrl\":\"/episode/the-bride-he-lost-2090738519481356290\",\"fullEpisodeNameUrl\":\"/full-episodes/the-bride-he-lost-2090738519481356290\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/733671833_标题3：4.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Vera Rose, the eldest daughter of the Rose family, sees through her fiancé Alex Hadley’s constant partiality toward Lily, her illegitimate half‑sister. After Alex shields her during a shooting incident, Vera chooses to take Lily’s place in a political marriage with Leon Costa, heir to the mafia Costa family, to cut ties with Alex. She lays careful plots in advance. At the wedding back home, she exposes Lily’s true identity and her father Henry’s schemes, shaking the Rose family. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092975554563\",\"labelName\":\"Romantic Marriage\",\"labelNameUrl\":\"/drama/Romantic%20Marriage-1983832092975554563\",\"language\":\"en\"},{\"labelId\":\"1983832091889229827\",\"labelName\":\"Rich Family Feud\",\"labelNameUrl\":\"/drama/Rich%20Family%20Feud-1983832091889229827\",\"language\":\"en\"}],\"totalEpisode\":30},{\"shortPlayLibraryId\":\"2090995467762110466\",\"shortPlayId\":\"2090995471335657474\",\"shortPlayName\":\"Auctioned By My Billionaire Husband\",\"shortPlayNameNoHL\":\"Auctioned By My Billionaire Husband\",\"shortPlayNameUrl\":\"/episode/auctioned-by-my-billionaire-husband-2090995471335657474\",\"fullEpisodeNameUrl\":\"/full-episodes/auctioned-by-my-billionaire-husband-2090995471335657474\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/792456572_3：4.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Rose, a woman of humble origins, has been married to billionaire heir Ethan for three years. Once the light of his life, she is completely cast aside after his mistress Chloe enters the picture.To force Rose to leave with nothing, Ethan ties her to the auction block at a high-society banquet to humiliate her publicly. Teaming up with Chloe, who fakes her pregnancy, he pressures her relentlessly: he places her under house arrest, forces her to kneel and apologize in front of the family elders, \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092405129218\",\"labelName\":\"Family Drama\",\"labelNameUrl\":\"/drama/Family%20Drama-1983832092405129218\",\"language\":\"en\"},{\"labelId\":\"1983832092975554563\",\"labelName\":\"Romantic Marriage\",\"labelNameUrl\":\"/drama/Romantic%20Marriage-1983832092975554563\",\"language\":\"en\"},{\"labelId\":\"1983832091901812738\",\"labelName\":\"Karma\",\"labelNameUrl\":\"/drama/Karma-1983832091901812738\",\"language\":\"en\"}],\"totalEpisode\":30},{\"shortPlayLibraryId\":\"2090996398310391810\",\"shortPlayId\":\"2090996404186611714\",\"shortPlayName\":\"Fatal Partners After Being Ambushed by My Scumbag Lover, I Seized the Entire Mafia\",\"shortPlayNameNoHL\":\"Fatal Partners After Being Ambushed by My Scumbag Lover, I Seized the Entire Mafia\",\"shortPlayNameUrl\":\"/episode/fatal-partners-after-being-ambushed-by-my-scumbag-lover-i-seized-the-entire-maf-2090996404186611714\",\"fullEpisodeNameUrl\":\"/full-episodes/fatal-partners-after-being-ambushed-by-my-scumbag-lover-i-seized-the-entire-maf-2090996404186611714\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/792723447_3：4.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Isabella, heir to the Moretti family, is deeply infatuated with her boyfriend Callo and repeatedly risks her life carrying out assassination missions for him. Despite cheating death multiple times, she firmly believes they will marry once he secures power. While scouting the mission site in advance, she accidentally uncovers the truth: the mission is a death trap plotted by Callo and his lover Margaret to kill her and seize her family's fortune. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092736479234\",\"labelName\":\"Modern Romance\",\"labelNameUrl\":\"/drama/Modern%20Romance-1983832092736479234\",\"language\":\"en\"},{\"labelId\":\"1983832091889229827\",\"labelName\":\"Rich Family Feud\",\"labelNameUrl\":\"/drama/Rich%20Family%20Feud-1983832091889229827\",\"language\":\"en\"},{\"labelId\":\"1983832091901812738\",\"labelName\":\"Karma\",\"labelNameUrl\":\"/drama/Karma-1983832091901812738\",\"language\":\"en\"}],\"totalEpisode\":32},{\"shortPlayLibraryId\":\"2090997242363740161\",\"shortPlayId\":\"2090997246721622017\",\"shortPlayName\":\"Heiress’ Fatal Feast \",\"shortPlayNameNoHL\":\"Heiress’ Fatal Feast \",\"shortPlayNameUrl\":\"/episode/heiress-fatal-feast-2090997246721622017\",\"fullEpisodeNameUrl\":\"/full-episodes/heiress-fatal-feast-2090997246721622017\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/800421823_3：4.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Lenora Bellamy, heir of the Bellamy family, hosts her brother Nolan’s girlfriend Kelsey. Arrogant and greedy, Kelsey steals jewelry and conspires with her mother Donna and cousin to assault Lenora in a bid to seize the family fortune. Her fiancé Miles arrives just‑in‑time to rescue her. Their crimes are exposed and they receive due legal punishment. Nolan matures after the ordeal. Later, Lenora takes over the group. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092405129218\",\"labelName\":\"Family Drama\",\"labelNameUrl\":\"/drama/Family%20Drama-1983832092405129218\",\"language\":\"en\"},{\"labelId\":\"1983832091889229827\",\"labelName\":\"Rich Family Feud\",\"labelNameUrl\":\"/drama/Rich%20Family%20Feud-1983832091889229827\",\"language\":\"en\"},{\"labelId\":\"1983832091901812738\",\"labelName\":\"Karma\",\"labelNameUrl\":\"/drama/Karma-1983832091901812738\",\"language\":\"en\"}],\"totalEpisode\":40},{\"shortPlayLibraryId\":\"2091000080586346498\",\"shortPlayId\":\"2091000084776456194\",\"shortPlayName\":\"Stolen Identity After Five‑Year Covert Mission\",\"shortPlayNameNoHL\":\"Stolen Identity After Five‑Year Covert Mission\",\"shortPlayNameUrl\":\"/episode/stolen-identity-after-fiveyear-covert-mission-2091000084776456194\",\"fullEpisodeNameUrl\":\"/full-episodes/stolen-identity-after-fiveyear-covert-mission-2091000084776456194\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/796850879_3-4.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"The missile chief designer David lived under an assumed name for five years, conducting scientific research in the desert. A radiation accident altered his appearance. Upon returning home, he discovered that his cousin Kevin had undergone plastic surgery to steal his identity, taking over his family and property, and even colluding with others to frame him. Relying on his professional expertise, David gained the trust of the police.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092736479234\",\"labelName\":\"Modern Romance\",\"labelNameUrl\":\"/drama/Modern%20Romance-1983832092736479234\",\"language\":\"en\"},{\"labelId\":\"1983832092405129218\",\"labelName\":\"Family Drama\",\"labelNameUrl\":\"/drama/Family%20Drama-1983832092405129218\",\"language\":\"en\"},{\"labelId\":\"1983832092279300099\",\"labelName\":\"Family Ethics\",\"labelNameUrl\":\"/drama/Family%20Ethics-1983832092279300099\",\"language\":\"en\"}],\"totalEpisode\":31},{\"shortPlayLibraryId\":\"2090685979502940161\",\"shortPlayId\":\"2090685979771375618\",\"shortPlayName\":\"The Stand-In Bride\",\"shortPlayNameNoHL\":\"The Stand-In Bride\",\"shortPlayNameUrl\":\"/episode/the-stand-in-bride-2090685979771375618\",\"fullEpisodeNameUrl\":\"/full-episodes/the-stand-in-bride-2090685979771375618\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/603975647_封面.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Her sister ran away from her engagement, so Urielle took her place and married billionaire CEO Oberon Garcia.She expected nothing more than a cold business marriage. But the husband who was supposed to be her brother-in-law starts protecting her, spoiling her, and choosing her over everyone else.Just when their arranged marriage begins to turn into real love, Oberon’s childhood sweetheart returns—and so does the man Urielle once loved.She was only meant to be the stand-in bride. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092975554563\",\"labelName\":\"Romantic Marriage\",\"labelNameUrl\":\"/drama/Romantic%20Marriage-1983832092975554563\",\"language\":\"en\"},{\"labelId\":\"1983832091939561474\",\"labelName\":\"Love After Marriage\",\"labelNameUrl\":\"/drama/Love%20After%20Marriage-1983832091939561474\",\"language\":\"en\"},{\"labelId\":\"1983832091914395651\",\"labelName\":\"Love Triangle\",\"labelNameUrl\":\"/drama/Love%20Triangle-1983832091914395651\",\"language\":\"en\"}],\"totalEpisode\":34},{\"shortPlayLibraryId\":\"2090686869559414786\",\"shortPlayId\":\"2090686869811073026\",\"shortPlayName\":\"The Sea Lord's Runaway Wife\",\"shortPlayNameNoHL\":\"The Sea Lord's Runaway Wife\",\"shortPlayNameUrl\":\"/episode/the-sea-lords-runaway-wife-2090686869811073026\",\"fullEpisodeNameUrl\":\"/full-episodes/the-sea-lords-runaway-wife-2090686869811073026\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/592302067_修改图片尺寸为1080_1440.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Five years ago, marine research director Yelena took a fatal blast meant for mermaid prince Austin and pretended to abandon him in order to protect his life. When they meet again, Yelena has become a pawn in an arranged marriage, while Austin has returned as both a mysterious tycoon and the Lord of the Deep Sea. Believing she betrayed him, he pursues her with vengeance and possessive determination. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092417712131\",\"labelName\":\"Fantasy Romance\",\"labelNameUrl\":\"/drama/Fantasy%20Romance-1983832092417712131\",\"language\":\"en\"},{\"labelId\":\"1983832092468043778\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832092468043778\",\"language\":\"en\"},{\"labelId\":\"1983832092367380482\",\"labelName\":\"Hate to Love\",\"labelNameUrl\":\"/drama/Hate%20to%20Love-1983832092367380482\",\"language\":\"en\"}],\"totalEpisode\":35},{\"shortPlayLibraryId\":\"2091788247006883842\",\"shortPlayId\":\"2091788346747432961\",\"shortPlayName\":\"The Beater Billionaire\",\"shortPlayNameNoHL\":\"The Beater Billionaire\",\"shortPlayNameUrl\":\"/episode/the-beater-billionaire-2091788346747432961\",\"fullEpisodeNameUrl\":\"/full-episodes/the-beater-billionaire-2091788346747432961\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2091788247006883842/a17de5103e244bc1a44c3e48e5baf220/2091806619866083329.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Leonard, a trillionaire, drives a pink car to stay low-key. Humiliated at Austin Tech, he reveals his identity, bankrupts them, and backs a rival. He protects his wife Sofia with $50M, defeats the Victor family, and rescues her from kidnapper White. They drive off in their pink car—proof a true king needs no flash.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036302733315\",\"labelName\":\"Revenge\",\"labelNameUrl\":\"/drama/Revenge-1983832036302733315\",\"language\":\"en\"},{\"labelId\":\"1983832036294344705\",\"labelName\":\"Karma Payback\",\"labelNameUrl\":\"/drama/Karma%20Payback-1983832036294344705\",\"language\":\"en\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2090747167729352705\",\"shortPlayId\":\"2090747232074170369\",\"shortPlayName\":\"Taboo Swap: Secrets Unleashed at Sea\",\"shortPlayNameNoHL\":\"Taboo Swap: Secrets Unleashed at Sea\",\"shortPlayNameUrl\":\"/episode/taboo-swap-secrets-unleashed-at-sea-2090747232074170369\",\"fullEpisodeNameUrl\":\"/full-episodes/taboo-swap-secrets-unleashed-at-sea-2090747232074170369\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/776339420_output.lin.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"After a lifeboat accident aboard the Olympic, Princess Catherine wakes with \\\"amnesia.\\\" To hide his affair with Molly, her husband Frederick pushes her toward his son Julian, claiming Julian is her true husband. Between a possessive ex and a restrained crown prince, Catherine plays innocent as forbidden desire draws closer while she reclaims fate.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832092270911490\",\"labelName\":\"Revenge\",\"labelNameUrl\":\"/drama/Revenge-1983832092270911490\",\"language\":\"en\"},{\"labelId\":\"1983832092279300099\",\"labelName\":\"Family Ethics\",\"labelNameUrl\":\"/drama/Family%20Ethics-1983832092279300099\",\"language\":\"en\"},{\"labelId\":\"1983832091692097539\",\"labelName\":\"Amnesia\",\"labelNameUrl\":\"/drama/Amnesia-1983832091692097539\",\"language\":\"en\"}],\"totalEpisode\":47},{\"shortPlayLibraryId\":\"2090749110002483201\",\"shortPlayId\":\"2090749166436843521\",\"shortPlayName\":\"The Apex Cheetah's Sheep Sweetheart\",\"shortPlayNameNoHL\":\"The Apex Cheetah's Sheep Sweetheart\",\"shortPlayNameUrl\":\"/episode/the-apex-cheetahs-sheep-sweetheart-2090749166436843521\",\"fullEpisodeNameUrl\":\"/full-episodes/the-apex-cheetahs-sheep-sweetheart-2090749166436843521\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/858341112_output.lin(4).png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Billionaire cheetah CEO Caleb torments his sheep ex-lover, Maya, believing she betrayed him eight years ago. He has no idea the lowly dishwasher is secretly raising their critically ill 7-year-old daughter alone. Can the truth save their child and reignite their love?\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832176002416642\",\"labelName\":\"Second Chance\",\"labelNameUrl\":\"/drama/Second%20Chance-1983832176002416642\",\"language\":\"en\"},{\"labelId\":\"1983832175285190658\",\"labelName\":\"Love After Divorce\",\"labelNameUrl\":\"/drama/Love%20After%20Divorce-1983832175285190658\",\"language\":\"en\"},{\"labelId\":\"1983832175792701442\",\"labelName\":\"Bitter Love\",\"labelNameUrl\":\"/drama/Bitter%20Love-1983832175792701442\",\"language\":\"en\"}],\"totalEpisode\":50}]}]\n"])</script><script>self.__next_f.push([1,"2b:I[95066,[\"8026\",\"static/chunks/8026-fdd01cef9ed9fcad.js\",\"1356\",\"static/chunks/1356-497180fb2a2b715f.js\",\"5604\",\"static/chunks/5604-cb71f96ffe3b244d.js\",\"5481\",\"static/chunks/5481-68517c0c75307f2a.js\",\"763\",\"static/chunks/763-40f1211051022861.js\",\"5751\",\"static/chunks/5751-fef6912a7c98bd8e.js\",\"8948\",\"static/chunks/8948-7fc7843fe137d55e.js\",\"4429\",\"static/chunks/app/%5Blocale%5D/drama/%5Bseries%5D/page-7a606cc1e87e0a1f.js\"],\"default\"]\n"])</script><script>self.__next_f.push([1,"6:[\"$L2a\",[\"$\",\"$L2b\",null,{\"locale\":\"en\",\"seriesSlug\":\"Good vs. Evil-1983832035849748482\",\"seriesInfo\":\"Good vs. Evil\",\"labelId\":\"1983832035849748482\",\"videoList\":[{\"shortPlayLibraryId\":\"2090980780014141441\",\"shortPlayId\":\"2090980782421671938\",\"shortPlayName\":\"Crushing The Village Bully\",\"shortPlayNameNoHL\":\"Crushing The Village Bully\",\"shortPlayNameUrl\":\"/episode/crushing-the-village-bully-2090980782421671938\",\"fullEpisodeNameUrl\":\"/full-episodes/crushing-the-village-bully-2090980782421671938\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2090980780014141441/1787552403219-1281685474716605-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"During a deadly drought, a ruthless local bully cuts off the village's only water supply just to farm crabs! While the desperate villagers beg for mercy, a mysterious hero makes a badass return. Refusing to back down, he steps up to crush the arrogant bully, reclaim their lifeline, and restore ultimate justice!\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"},{\"labelId\":\"1983832035958800386\",\"labelName\":\"Inheritance Battle\",\"labelNameUrl\":\"/drama/Inheritance%20Battle-1983832035958800386\",\"language\":\"en\"},{\"labelId\":\"1983832036969627650\",\"labelName\":\"Rural Life\",\"labelNameUrl\":\"/drama/Rural%20Life-1983832036969627650\",\"language\":\"en\"}],\"totalEpisode\":24},{\"shortPlayLibraryId\":\"2091442415476797441\",\"shortPlayId\":\"2091442445583511553\",\"shortPlayName\":\"Claimed by the Demon Queen\",\"shortPlayNameNoHL\":\"Claimed by the Demon Queen\",\"shortPlayNameUrl\":\"/episode/claimed-by-the-demon-queen-2091442445583511553\",\"fullEpisodeNameUrl\":\"/full-episodes/claimed-by-the-demon-queen-2091442445583511553\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/851569581_20260824-155138.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Sebastian, 18, forced to marry a Demon Queen to save his dying father, is both her curse's cure and bearer of a sacred stigma bloodline threatening the Demon King. From desperate survival to active choice, he binds his life to the feared ancient Queen, uniting to defy the Council of Elders, the Blood Moon Curse, and their fated identities.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036856381442\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832036856381442\",\"language\":\"en\"},{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"},{\"labelId\":\"1983832036613111810\",\"labelName\":\"Fantasy World\",\"labelNameUrl\":\"/drama/Fantasy%20World-1983832036613111810\",\"language\":\"en\"}],\"totalEpisode\":16},{\"shortPlayLibraryId\":\"2091374117913489409\",\"shortPlayId\":\"2091374147323949057\",\"shortPlayName\":\"The Mob Boss Is a Magical Girl\",\"shortPlayNameNoHL\":\"The Mob Boss Is a Magical Girl\",\"shortPlayNameUrl\":\"/episode/the-mob-boss-is-a-magical-girl-2091374147323949057\",\"fullEpisodeNameUrl\":\"/full-episodes/the-mob-boss-is-a-magical-girl-2091374147323949057\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/759168410_output.lin.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Mob boss Ike Parker is killed by a monster, only to be reborn with the power to transform into a magical girl. As he fights crime in his new form, his youngerown stepsister Annie falls hopelessly in love with him, never suspecting the truth. Together, they take down an evil organization and save the world.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036369842178\",\"labelName\":\"Superpowered\",\"labelNameUrl\":\"/drama/Superpowered-1983832036369842178\",\"language\":\"en\"},{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"},{\"labelId\":\"1983832036474699778\",\"labelName\":\"Hilarious\",\"labelNameUrl\":\"/drama/Hilarious-1983832036474699778\",\"language\":\"en\"}],\"totalEpisode\":16},{\"shortPlayLibraryId\":\"2090726261258813442\",\"shortPlayId\":\"2090726316145479681\",\"shortPlayName\":\"You Called Me a Traitor Now Winter is Here\",\"shortPlayNameNoHL\":\"You Called Me a Traitor Now Winter is Here\",\"shortPlayNameUrl\":\"/episode/you-called-me-a-traitor-now-winter-is-here-2090726316145479681\",\"fullEpisodeNameUrl\":\"/full-episodes/you-called-me-a-traitor-now-winter-is-here-2090726316145479681\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/757940074_output.lin-2.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Red, Holy Light Realm’s guardian Dragon‑Knight, held the Far‑North Ice Wastes against Frost Wraiths for twenty years. Fleeing for aid, he’s framed for treason. As execution nears, King Noctis with his frost dragon and million wraiths besiege the capital — the fateful Winter dawns.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036860575747\",\"labelName\":\"Urban Fantasy\",\"labelNameUrl\":\"/drama/Urban%20Fantasy-1983832036860575747\",\"language\":\"en\"},{\"labelId\":\"1983832036294344705\",\"labelName\":\"Karma Payback\",\"labelNameUrl\":\"/drama/Karma%20Payback-1983832036294344705\",\"language\":\"en\"},{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"}],\"totalEpisode\":55},{\"shortPlayLibraryId\":\"2086644612474642434\",\"shortPlayId\":\"2086644677159198722\",\"shortPlayName\":\"Boxer Proficient In Kungfu\",\"shortPlayNameNoHL\":\"Boxer Proficient In Kungfu\",\"shortPlayNameUrl\":\"/episode/boxer-proficient-in-kungfu-2086644677159198722\",\"fullEpisodeNameUrl\":\"/full-episodes/boxer-proficient-in-kungfu-2086644677159198722\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/-370460673_3_4(1).png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Boxing king Ventura abandoned his disabled newborn Arnold at sea 20 years ago. Miraculously rescued by a hermit kung fu master, Arnold grew into a lethal fighter bearing the Lion King Ring. He cruelly cripples Arnold's hands and kidnaps both his mother and sister. At his lowest point, the real battle for vengeance is only just beginning.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036294344705\",\"labelName\":\"Karma Payback\",\"labelNameUrl\":\"/drama/Karma%20Payback-1983832036294344705\",\"language\":\"en\"},{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"},{\"labelId\":\"1983832036508254210\",\"labelName\":\"Redemption\",\"labelNameUrl\":\"/drama/Redemption-1983832036508254210\",\"language\":\"en\"}],\"totalEpisode\":41},{\"shortPlayLibraryId\":\"2087015786409115649\",\"shortPlayId\":\"2087015790062354433\",\"shortPlayName\":\"Rejected Fiancé, Supreme Sword Saint!\",\"shortPlayNameNoHL\":\"Rejected Fiancé, Supreme Sword Saint!\",\"shortPlayNameUrl\":\"/episode/rejected-fiancé-supreme-sword-saint-2087015790062354433\",\"fullEpisodeNameUrl\":\"/full-episodes/rejected-fiancé-supreme-sword-saint-2087015790062354433\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2087015786409115649/1787378135959-1703090137387595-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"After helping his fiancée Clara Sullivan awaken, Theo Lynn is cast out and hunted by the Sullivans until his Origin Martial Soul, the Primordial Dao Sword, unseals. At Heavenly Dao Academy on Forsaken Sword Peak, he learns his family’s massacre links to the Demon Abyss. When Young Master Chase attacks again, who is behind it all?\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036898324482\",\"labelName\":\"Eastern Fantasy\",\"labelNameUrl\":\"/drama/Eastern%20Fantasy-1983832036898324482\",\"language\":\"en\"},{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036302733315\",\"labelName\":\"Revenge\",\"labelNameUrl\":\"/drama/Revenge-1983832036302733315\",\"language\":\"en\"}],\"totalEpisode\":72},{\"shortPlayLibraryId\":\"2089890745037938689\",\"shortPlayId\":\"2089890747537743873\",\"shortPlayName\":\"Fishing for the Pantheon\",\"shortPlayNameNoHL\":\"Fishing for the Pantheon\",\"shortPlayNameUrl\":\"/episode/fishing-for-the-pantheon-2089890747537743873\",\"fullEpisodeNameUrl\":\"/full-episodes/fishing-for-the-pantheon-2089890747537743873\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089890745037938689/1787297146982-8915447159286087-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Billions of humans are trapped in a floating sea with tiny islands and only fishing rods. A retired soldier with a replication talent fishes out powerful gods, builds comprehensive civil and military systems, crushes violent invading forces, and finally dominates the realm to explore ancient titan secrets.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036856381442\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832036856381442\",\"language\":\"en\"},{\"labelId\":\"1983832036898324482\",\"labelName\":\"Eastern Fantasy\",\"labelNameUrl\":\"/drama/Eastern%20Fantasy-1983832036898324482\",\"language\":\"en\"}],\"totalEpisode\":42},{\"shortPlayLibraryId\":\"2089906984347029506\",\"shortPlayId\":\"2089906986964275202\",\"shortPlayName\":\"The Western Godfather: Rise of the Moonblood\",\"shortPlayNameNoHL\":\"The Western Godfather: Rise of the Moonblood\",\"shortPlayNameUrl\":\"/episode/the-western-godfather-rise-of-the-moonblood-2089906986964275202\",\"fullEpisodeNameUrl\":\"/full-episodes/the-western-godfather-rise-of-the-moonblood-2089906986964275202\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2089906984347029506/eaac8a899a964c92b542907ba330cee9/2090718533736275969.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Eric, the Falcone family's second youngest and New York's underworld king, was abandoned at birth for lacking werewolf blood. Years later, he returns seeking family but is rejected again. When the Falcone family falls into crisis under rival siege, Eric saves them for his mother and sister. This draws him into a two‑decade‑old werewolf upheaval. On a full‑moon night, he awakens the Wolf‑God bloodline, defeats black magic user Mike, and rises as the new werewolf king.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036285956098\",\"labelName\":\"Return of the King\",\"labelNameUrl\":\"/drama/Return%20of%20the%20King-1983832036285956098\",\"language\":\"en\"}],\"totalEpisode\":46},{\"shortPlayLibraryId\":\"2090713776480948225\",\"shortPlayId\":\"2090713860283138050\",\"shortPlayName\":\"The Distressed Omega of the Star Commander\",\"shortPlayNameNoHL\":\"The Distressed Omega of the Star Commander\",\"shortPlayNameUrl\":\"/episode/the-distressed-omega-of-the-star-commander-2090713860283138050\",\"fullEpisodeNameUrl\":\"/full-episodes/the-distressed-omega-of-the-star-commander-2090713860283138050\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/593874937_20260821-161646.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"This interstellar ABO tale follows gifted rare Omega starmapper Elias. He rescues injured Alliance Supreme Commander Damian at the border, and fate draws them together, until war separates them.Pregnant, Elias is sold by greedy adoptive parents to cruel border lord Salon and imprisoned for nine years. His son Noah, heir to royal‑grade blood, is shackled and forced to fake a child prodigy drawing star charts for profit.Damian tracks them via distinctive star‑chart marks. Surviving impostor plots,\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036856381442\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832036856381442\",\"language\":\"en\"},{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"},{\"labelId\":\"1983832036432756738\",\"labelName\":\"Drama\",\"labelNameUrl\":\"/drama/Drama-1983832036432756738\",\"language\":\"en\"}],\"totalEpisode\":16},{\"shortPlayLibraryId\":\"2090370054782287873\",\"shortPlayId\":\"2090370119559122945\",\"shortPlayName\":\"The Vessel Beneath His strap\",\"shortPlayNameNoHL\":\"The Vessel Beneath His strap\",\"shortPlayNameUrl\":\"/episode/the-vessel-beneath-his-strap-2090370119559122945\",\"fullEpisodeNameUrl\":\"/full-episodes/the-vessel-beneath-his-strap-2090370119559122945\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/596424443_皮带海报.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Caleb intrudes on CEO Adrian's chamber to save his brother and is forced into a chastity-lock contract. His design talent shines amid domination and submission; desire entangles them, but Adrian, fearing love, pushes him away. Julian and Victor scheme. After deadly trials, Adrian's guard shatters; true love destroys the unequal contract, making them eternal soulmates.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036889935874\",\"labelName\":\"Urban Life\",\"labelNameUrl\":\"/drama/Urban%20Life-1983832036889935874\",\"language\":\"en\"},{\"labelId\":\"1983832036546002947\",\"labelName\":\"Modern\",\"labelNameUrl\":\"/drama/Modern-1983832036546002947\",\"language\":\"en\"},{\"labelId\":\"1983832036508254210\",\"labelName\":\"Redemption\",\"labelNameUrl\":\"/drama/Redemption-1983832036508254210\",\"language\":\"en\"}],\"totalEpisode\":14},{\"shortPlayLibraryId\":\"2089652108702568450\",\"shortPlayId\":\"2089652111550500865\",\"shortPlayName\":\"The Pit Wall Bastard\",\"shortPlayNameNoHL\":\"The Pit Wall Bastard\",\"shortPlayNameUrl\":\"/episode/the-pit-wall-bastard-2089652111550500865\",\"fullEpisodeNameUrl\":\"/full-episodes/the-pit-wall-bastard-2089652111550500865\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2089652108702568450/9893630250a143418602875512c93daa/2090323220072243201.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Soren, once a prodigy driver, was betrayed by his brother Cassian—who stole his glory. With two grand and a wrecked car, he builds Black Wall Racing from a bridge. He recruits outcast drivers Mika and Rhea. Together, they battle elites, sabotage, and lies. In the final rain race, Soren's call wins. Truth restores his name. Speed doesn't lie—and neither does legacy.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036906713091\",\"labelName\":\"Coporate Warfare\",\"labelNameUrl\":\"/drama/Coporate%20Warfare-1983832036906713091\",\"language\":\"en\"},{\"labelId\":\"1983832036889935874\",\"labelName\":\"Urban Life\",\"labelNameUrl\":\"/drama/Urban%20Life-1983832036889935874\",\"language\":\"en\"}],\"totalEpisode\":35},{\"shortPlayLibraryId\":\"2089242764693086209\",\"shortPlayId\":\"2089242775480836098\",\"shortPlayName\":\"LUNAR SAINT AND WOLF KING\",\"shortPlayNameNoHL\":\"LUNAR SAINT AND WOLF KING\",\"shortPlayNameUrl\":\"/episode/lunar-saint-and-wolf-king-2089242775480836098\",\"fullEpisodeNameUrl\":\"/full-episodes/lunar-saint-and-wolf-king-2089242775480836098\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/268430971_7月27日(1)-封面.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Orphaned Lucian carries the divine cleansing blood of a Moon-Guider but is abused by his uncle's family and nearly sold to a black market. After his seal breaks, elders of the Nightblood clan help him escape. His moonlight power cures silver poisoning, revives the clan's sacred vine, and restores the legs of Victor, the wolf emperor crippled by betrayal. The two form a soul pact, uncover the truth of Lucian's father's sacrifice, and purge traitors. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036856381442\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832036856381442\",\"language\":\"en\"},{\"labelId\":\"1983832036898324482\",\"labelName\":\"Eastern Fantasy\",\"labelNameUrl\":\"/drama/Eastern%20Fantasy-1983832036898324482\",\"language\":\"en\"}],\"totalEpisode\":35},{\"shortPlayLibraryId\":\"2089548989180080130\",\"shortPlayId\":\"2089548993416327170\",\"shortPlayName\":\"Death Warning From 10 Years Later\",\"shortPlayNameNoHL\":\"Death Warning From 10 Years Later\",\"shortPlayNameUrl\":\"/episode/death-warning-from-10-years-later-2089548993416327170\",\"fullEpisodeNameUrl\":\"/full-episodes/death-warning-from-10-years-later-2089548993416327170\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/335544109_1080-1440.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"English SynopsisLeo, the top student at Norton Law School, unexpectedly receives a death warning from his best friend Max from ten years in the future: he will fall to his death from the old clock tower on final exam day, and Max will be wrongfully imprisoned for a decade as a result. After the predictions come true one by one, Leo is convinced the danger is real. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036889935874\",\"labelName\":\"Urban Life\",\"labelNameUrl\":\"/drama/Urban%20Life-1983832036889935874\",\"language\":\"en\"},{\"labelId\":\"1983832036940267523\",\"labelName\":\"Mystery\",\"labelNameUrl\":\"/drama/Mystery-1983832036940267523\",\"language\":\"en\"},{\"labelId\":\"1983832035950411778\",\"labelName\":\"Friendship\",\"labelNameUrl\":\"/drama/Friendship-1983832035950411778\",\"language\":\"en\"}],\"totalEpisode\":31},{\"shortPlayLibraryId\":\"2086644386451988482\",\"shortPlayId\":\"2086644390042312705\",\"shortPlayName\":\"The Sword God's Last Hangover\",\"shortPlayNameNoHL\":\"The Sword God's Last Hangover\",\"shortPlayNameUrl\":\"/episode/the-sword-gods-last-hangover-2086644390042312705\",\"fullEpisodeNameUrl\":\"/full-episodes/the-sword-gods-last-hangover-2086644390042312705\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2086644386451988482/1787194608616-2619969641422357-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"The greatest swordsman fell from heaven and became a drunk escort. The girl he guards is the only key to breaking the gods' seal. Enemies hunt her. He fights with a branch until the sky remembers him. On the summit, he raises a blade forged from ten thousand swords. Can heaven survive the myth he shatters?\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036898324482\",\"labelName\":\"Eastern Fantasy\",\"labelNameUrl\":\"/drama/Eastern%20Fantasy-1983832036898324482\",\"language\":\"en\"},{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"},{\"labelId\":\"1999056777395978242\",\"labelName\":\"Multiple Identities\",\"labelNameUrl\":\"/drama/Multiple%20Identities-1999056777395978242\",\"language\":\"en\"}],\"totalEpisode\":60},{\"shortPlayLibraryId\":\"2089537947888525314\",\"shortPlayId\":\"2089537950434467842\",\"shortPlayName\":\"The Expired Fruit King\",\"shortPlayNameNoHL\":\"The Expired Fruit King\",\"shortPlayNameUrl\":\"/episode/the-expired-fruit-king-2089537950434467842\",\"fullEpisodeNameUrl\":\"/full-episodes/the-expired-fruit-king-2089537950434467842\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089537947888525314/1787132893493-.967906147754626-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"At 63, Martin is deemed \\\"expired\\\" by AI and dumped in a compost zone. Armed with an obsolete price gun, he repairs discarded goods and restores their lifespan. With Pip, a hidden royal heir, he builds a market for outcasts, exposes the council's life-stealing scheme, and leads a rebellion to end the \\\"expired\\\" system.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036856381442\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832036856381442\",\"language\":\"en\"},{\"labelId\":\"1983832036948656131\",\"labelName\":\"Sci-Fi\",\"labelNameUrl\":\"/drama/Sci-Fi-1983832036948656131\",\"language\":\"en\"}],\"totalEpisode\":43},{\"shortPlayLibraryId\":\"2089533846714847234\",\"shortPlayId\":\"2089533852792393729\",\"shortPlayName\":\"Upgrade\",\"shortPlayNameNoHL\":\"Upgrade\",\"shortPlayNameUrl\":\"/episode/upgrade-2089533852792393729\",\"fullEpisodeNameUrl\":\"/full-episodes/upgrade-2089533852792393729\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/ai_poster/2089533846714847234/b2bbc865d932433f92b99caed628f8af/2089997106841800705.jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"At 58, Jackson is a humiliated janitor betrayed by his wife and bosses. Then he unlocks his grandfather's Value Scanner, which restores anything deemed worthless. Teaming up with a mysterious heiress, he exposes corporate corruption, uncovers a citywide energy conspiracy, and becomes the guardian of the forgotten.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036856381442\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832036856381442\",\"language\":\"en\"},{\"labelId\":\"1983832036948656131\",\"labelName\":\"Sci-Fi\",\"labelNameUrl\":\"/drama/Sci-Fi-1983832036948656131\",\"language\":\"en\"}],\"totalEpisode\":30},{\"shortPlayLibraryId\":\"2089537026429296641\",\"shortPlayId\":\"2089537029755379713\",\"shortPlayName\":\"Son of Chaos Return to the Mortal Realm\",\"shortPlayNameNoHL\":\"Son of Chaos Return to the Mortal Realm\",\"shortPlayNameUrl\":\"/episode/son-of-chaos-return-to-the-mortal-realm-2089537029755379713\",\"fullEpisodeNameUrl\":\"/full-episodes/son-of-chaos-return-to-the-mortal-realm-2089537029755379713\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089537026429296641/1787123057537-7448485204362759-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Framed by his stepmother and half-brother, Adrian is imprisoned for 3 years, where Chaos grants him power. After learning his childhood love is being forced to marry his enemy, he breaks free, returns for revenge, and wins the Divine Blood Tournament. Crowned Grand Duke, Adrian unfolds the truth and saves the kingdom, awaking the true Typhon.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036856381442\",\"labelName\":\"Fantasy\",\"labelNameUrl\":\"/drama/Fantasy-1983832036856381442\",\"language\":\"en\"},{\"labelId\":\"1983832036898324482\",\"labelName\":\"Eastern Fantasy\",\"labelNameUrl\":\"/drama/Eastern%20Fantasy-1983832036898324482\",\"language\":\"en\"}],\"totalEpisode\":40},{\"shortPlayLibraryId\":\"2089623837684203521\",\"shortPlayId\":\"2089623905552236545\",\"shortPlayName\":\"She Hurt My Daughter, Then Lost Everything\",\"shortPlayNameNoHL\":\"She Hurt My Daughter, Then Lost Everything\",\"shortPlayNameUrl\":\"/episode/she-hurt-my-daughter-then-lost-everything-2089623905552236545\",\"fullEpisodeNameUrl\":\"/full-episodes/she-hurt-my-daughter-then-lost-everything-2089623905552236545\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/421708763_3-4(31).jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Ethan Voss seems blessed with a perfect second wife, Ivy, until he finds his daughter Luna shivering in the hall, eating moldy bread. His investigation exposes Ivy as a Black Widow after his fortune, and Ethan begins a cold reckoning.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036889935874\",\"labelName\":\"Urban Life\",\"labelNameUrl\":\"/drama/Urban%20Life-1983832036889935874\",\"language\":\"en\"},{\"labelId\":\"1983832036424368130\",\"labelName\":\"Inspiring\",\"labelNameUrl\":\"/drama/Inspiring-1983832036424368130\",\"language\":\"en\"},{\"labelId\":\"1983832036546002947\",\"labelName\":\"Modern\",\"labelNameUrl\":\"/drama/Modern-1983832036546002947\",\"language\":\"en\"}],\"totalEpisode\":9},{\"shortPlayLibraryId\":\"2088784646490095617\",\"shortPlayId\":\"2088784715767414786\",\"shortPlayName\":\"Modern Underdog, Medieval King\",\"shortPlayNameNoHL\":\"Modern Underdog, Medieval King\",\"shortPlayNameUrl\":\"/episode/modern-underdog-medieval-king-2088784715767414786\",\"fullEpisodeNameUrl\":\"/full-episodes/modern-underdog-medieval-king-2088784715767414786\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/230424575_output.lin(2).png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Lucien, a useless duke's heir, is replaced by a modern transmigrator with a time-space bracelet. He brings modern weapons to the medieval world, shines at the royal hunt, annuls his engagement, defeats 200k barbarians with 10 knights, destroys 30 pirate ships with one destroyer, and hunts beasts with missiles.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036336287746\",\"labelName\":\"Time Travel\",\"labelNameUrl\":\"/drama/Time%20Travel-1983832036336287746\",\"language\":\"en\"},{\"labelId\":\"1983832035958800386\",\"labelName\":\"Inheritance Battle\",\"labelNameUrl\":\"/drama/Inheritance%20Battle-1983832035958800386\",\"language\":\"en\"},{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"}],\"totalEpisode\":50},{\"shortPlayLibraryId\":\"2089171185195876353\",\"shortPlayId\":\"2089171187683098625\",\"shortPlayName\":\"Children Of Resonance：Saving Human Hearts\",\"shortPlayNameNoHL\":\"Children Of Resonance：Saving Human Hearts\",\"shortPlayNameUrl\":\"/episode/children-of-resonancesaving-human-hearts-2089171187683098625\",\"fullEpisodeNameUrl\":\"/full-episodes/children-of-resonancesaving-human-hearts-2089171187683098625\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/imageG/production/2089171185195876353/1787040595426-6478532155031514-3比4jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"In Nova City, Jace and his team become Frequency Guardians. They face Abyss Beasts, which are creatures born from human emotions. Ornn, the network's creator, plans to delete all human emotions to stop conflict. The team stops him, choosing to embrace emotions and live peacefully with the beasts.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832035870720002\",\"labelName\":\"Men Coming-of-Age\",\"labelNameUrl\":\"/drama/Men%20Coming-of-Age-1983832035870720002\",\"language\":\"en\"}],\"totalEpisode\":52},{\"shortPlayLibraryId\":\"2089540370812112897\",\"shortPlayId\":\"2089540441427419137\",\"shortPlayName\":\"Desert’s Silent Blade\",\"shortPlayNameNoHL\":\"Desert’s Silent Blade\",\"shortPlayNameUrl\":\"/episode/deserts-silent-blade-2089540441427419137\",\"fullEpisodeNameUrl\":\"/full-episodes/deserts-silent-blade-2089540441427419137\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/337369051_沙海藏锋3：4独家.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"In Alakine Desert, Kaelo—once the godlike \\\"Desert King\\\"—hides as a mechanic after his power killed his wife. When his daughter Nia is targeted by the Psionic Union and the Klan, he unleashes his might to save her. Betrayed by the Union, he leads survivors to Holy Mountain, sacrificing himself as a false god to shield the true savior. Blue rain falls, ending the war and reviving the desert.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036369842178\",\"labelName\":\"Superpowered\",\"labelNameUrl\":\"/drama/Superpowered-1983832036369842178\",\"language\":\"en\"},{\"labelId\":\"1983832036302733315\",\"labelName\":\"Revenge\",\"labelNameUrl\":\"/drama/Revenge-1983832036302733315\",\"language\":\"en\"},{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"}],\"totalEpisode\":13},{\"shortPlayLibraryId\":\"2089285290787479553\",\"shortPlayId\":\"2089285515342127106\",\"shortPlayName\":\"The Odyssey\",\"shortPlayNameNoHL\":\"The Odyssey\",\"shortPlayNameUrl\":\"/episode/the-odyssey-2089285515342127106\",\"fullEpisodeNameUrl\":\"/full-episodes/the-odyssey-2089285515342127106\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/258523071_3：4带标.png~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Odysseus, a legendary hero lost to amnesia, becomes a beggar on a cursed isle. After blinding a Cyclops to save a city, he conquers three divine trials to regain his memory. Defying a Sea God's curse and seductive traps, the King of Ithaca must use his wits to conquer monsters and find his way home.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en\"},{\"labelId\":\"1983832036294344705\",\"labelName\":\"Karma Payback\",\"labelNameUrl\":\"/drama/Karma%20Payback-1983832036294344705\",\"language\":\"en\"},{\"labelId\":\"1983832035912663043\",\"labelName\":\"Heritage Awakening\",\"labelNameUrl\":\"/drama/Heritage%20Awakening-1983832035912663043\",\"language\":\"en\"}],\"totalEpisode\":35},{\"shortPlayLibraryId\":\"2089280772955836417\",\"shortPlayId\":\"2089280806984228865\",\"shortPlayName\":\"The Ransom of Leo\",\"shortPlayNameNoHL\":\"The Ransom of Leo\",\"shortPlayNameUrl\":\"/episode/the-ransom-of-leo-2089280806984228865\",\"fullEpisodeNameUrl\":\"/full-episodes/the-ransom-of-leo-2089280806984228865\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/327802796_主海报（3-4).jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Billionaire Richard’s son Leo is kidnapped. The kidnapper demands $100 million and humiliating live sex with a pig. Richard fakes his death to outwit the villain, hires Victor to rescue Leo, and lures the mastermind into a trap. After a brutal standoff and explosion, Richard defeats the foe and reunites safely with his family. \",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036923490307\",\"labelName\":\"Crime\",\"labelNameUrl\":\"/drama/Crime-1983832036923490307\",\"language\":\"en\"},{\"labelId\":\"1983832035983966211\",\"labelName\":\"Legal Justice\",\"labelNameUrl\":\"/drama/Legal%20Justice-1983832035983966211\",\"language\":\"en\"},{\"labelId\":\"1983832035849748482\",\"labelName\":\"Good vs. Evil\",\"labelNameUrl\":\"/drama/Good%20vs.%20Evil-1983832035849748482\",\"language\":\"en\"}],\"totalEpisode\":15},{\"shortPlayLibraryId\":\"2088799034592784386\",\"shortPlayId\":\"2088799120982863874\",\"shortPlayName\":\"The Hidden Founder of Aetherpaw City\",\"shortPlayNameNoHL\":\"The Hidden Founder of Aetherpaw City\",\"shortPlayNameUrl\":\"/episode/the-hidden-founder-of-aetherpaw-city-2088799120982863874\",\"fullEpisodeNameUrl\":\"/full-episodes/the-hidden-founder-of-aetherpaw-city-2088799120982863874\",\"shortPlayCover\":\"https://awscover.netshort.com/tos-vod-mya-v-da59d5a2040f5f77/coverG/prod/258375135_3：4(17).jpg~tplv-vod-rs:651:868.webp\",\"shotIntroduce\":\"Karen, the founder and mayor of Animal City, secretly lived as a ride-share driver for three years. His wife Selene despised his \\\"low status\\\" and left him for crocodile tycoon Rick. After saving Scarlett, a powerful CEO, Karen is humiliated at the city's centennial gala—until his true identity is revealed. As Selene and Rick fall from grace, Karen rises to the top beside Scarlett.\",\"language\":\"en_US\",\"labelList\":[{\"labelId\":\"1983832036302733315\",\"labelName\":\"Revenge\",\"labelNameUrl\":\"/drama/Revenge-1983832036302733315\",\"language\":\"en\"},{\"labelId\":\"1983832036889935874\",\"labelName\":\"Urban Life\",\"labelNameUrl\":\"/drama/Urban%20Life-1983832036889935874\",\"language\":\"en\"},{\"labelId\":\"1983832036390813699\",\"labelName\":\"Feel-Good\",\"labelNameUrl\":\"/drama/Feel-Good-1983832036390813699\",\"language\":\"en\"}],\"totalEpisode\":50}],\"totalCount\":147,\"pageNum\":1,\"pageSize\":24,\"initialLabelList\":[{\"labelId\":\"1983832036239818755\",\"labelName\":\"Underdog Rise\",\"labelNameUrl\":\"/drama/Underdog%20Rise-1983832036239818755\",\"language\":\"en_US\"},{\"labelId\":\"1983832036390813699\",\"labelName\":\"Feel-Good\",\"labelNameUrl\":\"/drama/Feel-Good-1983832036390813699\",\"language\":\"en_US\"},{\"labelId\":\"1983832091151032322\",\"labelName\":\"Sweet Romance\",\"labelNameUrl\":\"/drama/Sweet%20Romance-1983832091151032322\",\"language\":\"en_US\"},{\"labelId\":\"1983832036533420034\",\"labelName\":\"Historical\",\"labelNameUrl\":\"/drama/Historical-1983832036533420034\",\"language\":\"en_US\"},{\"labelId\":\"1983832036302733315\",\"labelName\":\"Revenge\",\"labelNameUrl\":\"/drama/Revenge-1983832036302733315\",\"language\":\"en_US\"},{\"labelId\":\"1983832092405129218\",\"labelName\":\"Family Drama\",\"labelNameUrl\":\"/drama/Family%20Drama-1983832092405129218\",\"language\":\"en_US\"},{\"labelId\":\"1983832091075534850\",\"labelName\":\"Tragic Love\",\"labelNameUrl\":\"/drama/Tragic%20Love-1983832091075534850\",\"language\":\"en_US\"},{\"labelId\":\"1983832036906713091\",\"labelName\":\"Coporate Warfare\",\"labelNameUrl\":\"/drama/Coporate%20Warfare-1983832036906713091\",\"language\":\"en_US\"},{\"labelId\":\"1983832036273373187\",\"labelName\":\"Rebirth\",\"labelNameUrl\":\"/drama/Rebirth-1983832036273373187\",\"language\":\"en_US\"},{\"labelId\":\"1983832092153470979\",\"labelName\":\"Werewolf\",\"labelNameUrl\":\"/drama/Werewolf-1983832092153470979\",\"language\":\"en_US\"}]}]]\n"])</script><script>self.__n